<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/images/logo-favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Create your StayAndaman account to explore 800+ verified stays across hotels, lodges, and rentals in Andaman.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <title>Create Account — StayAndaman</title>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --teal: #0abf8a;
      --teal-dark: #07a876;
      --navy: #0d1b2a;
      --gold: #f5a623;
      --off-white: #f4f7fb;
      --shadow-xl: 0 32px 80px rgba(0,0,0,0.18);
    }

    html, body {
      min-height: 100%;
      font-family: 'Inter', system-ui, sans-serif;
    }

    body {
      background: var(--off-white);
    }

    /* ===== TOP NAV BAR ===== */
    .signup-topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0,0,0,0.07);
      padding: 14px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .topbar-logo {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-weight: 800;
      color: var(--navy);
      text-decoration: none;
    }
    .topbar-logo span { color: var(--teal); }

    .topbar-signin {
      font-size: 13.5px;
      color: #64748b;
    }
    .topbar-signin a {
      color: var(--teal-dark);
      font-weight: 600;
      text-decoration: none;
      margin-left: 4px;
    }
    .topbar-signin a:hover { text-decoration: underline; }

    /* ===== PAGE WRAPPER ===== */
    .signup-page {
      min-height: calc(100vh - 57px);
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 40px 20px 60px;
    }

    /* ===== SIGNUP CARD ===== */
    .signup-card {
      width: 100%;
      max-width: 680px;
      background: #fff;
      border-radius: 24px;
      box-shadow: var(--shadow-xl);
      overflow: hidden;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1);
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Card Header */
    .signup-card-header {
      background: linear-gradient(135deg, var(--navy) 0%, #1a3a52 100%);
      padding: 36px 40px 32px;
      position: relative;
      overflow: hidden;
    }

    .signup-card-header::before {
      content: '';
      position: absolute;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(10,191,138,0.2), transparent 70%);
      top: -80px;
      right: -60px;
    }

    .signup-card-header::after {
      content: '';
      position: absolute;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(245,166,35,0.1), transparent 70%);
      bottom: -40px;
      left: 60px;
    }

    .header-content {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }

    .header-text h1 {
      font-family: 'Playfair Display', serif;
      font-size: 28px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 6px;
    }

    .header-text p {
      font-size: 14px;
      color: rgba(255,255,255,0.6);
      line-height: 1.5;
    }
    .header-text p a {
      color: var(--teal);
      font-weight: 600;
      text-decoration: none;
    }
    .header-text p a:hover { text-decoration: underline; }

    /* Avatar Upload */
    .avatar-upload-zone {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .avatar-circle {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(255,255,255,0.12);
      border: 2px dashed rgba(255,255,255,0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      position: relative;
      transition: border-color 0.2s, background 0.2s;
    }
    .avatar-circle:hover {
      border-color: var(--teal);
      background: rgba(10,191,138,0.12);
    }
    .avatar-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }
    .avatar-circle svg { width: 28px; height: 28px; color: rgba(255,255,255,0.5); }

    .avatar-edit-badge {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 22px;
      height: 22px;
      background: var(--teal);
      border-radius: 50%;
      border: 2px solid rgba(13,27,42,0.9);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .avatar-edit-badge svg { width: 10px; height: 10px; color: #fff; }

    .avatar-label {
      font-size: 10px;
      font-weight: 600;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.5px;
    }

    /* Progress bar */
    .signup-progress {
      padding: 0 40px;
      margin-top: -1px;
      background: #fff;
      padding-top: 20px;
    }

    .progress-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 6px;
    }
    .progress-label { color: #64748b; }
    .progress-pct { color: var(--teal-dark); font-variant-numeric: tabular-nums; }

    .progress-track {
      height: 5px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--teal), var(--teal-dark));
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    /* Form body */
    .signup-form-body {
      padding: 28px 40px 36px;
    }

    /* Alert */
    .alert-box {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 13.5px;
      line-height: 1.5;
      margin-bottom: 20px;
    }
    .alert-box svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
    .alert-error { background: #fff0f0; color: #c0392b; border: 1px solid rgba(192,57,43,0.2); }

    /* Section heading */
    .form-section-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #94a3b8;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid #f0f4f8;
    }

    /* Two column row */
    .field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }
    .field-row.single {
      grid-template-columns: 1fr;
    }

    .field-group { }

    .field-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 6px;
      letter-spacing: 0.3px;
    }
    .field-required { color: var(--teal); margin-left: 2px; }

    .field-input-wrap { position: relative; }
    .field-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 17px;
      height: 17px;
      color: #94a3b8;
      pointer-events: none;
      transition: color 0.2s;
    }
    /* For select, icon adjustment */
    .field-input-wrap .select-caret {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      width: 16px;
      height: 16px;
      color: #94a3b8;
    }

    .field-input, .field-select {
      width: 100%;
      padding: 11px 12px 11px 40px;
      font-size: 14px;
      font-family: 'Inter', sans-serif;
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      color: var(--navy);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
      appearance: none;
    }
    .field-input:focus, .field-select:focus {
      border-color: var(--teal);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(10,191,138,0.1);
    }
    .field-input-wrap:focus-within .field-icon { color: var(--teal); }
    .field-input::placeholder, .field-select::placeholder { color: #b0bec5; }
    .field-select option { background: #fff; color: var(--navy); }

    .field-error-msg {
      font-size: 11px;
      color: #e53e3e;
      margin-top: 4px;
      padding-left: 2px;
      display: none;
    }
    .field-group.has-error .field-input,
    .field-group.has-error .field-select { border-color: #fc8181; background: #fff5f5; }
    .field-group.has-error .field-error-msg { display: block; }

    /* Terms */
    .terms-wrap {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 24px;
      margin-top: 6px;
    }
    .terms-wrap input[type="checkbox"] {
      width: 17px;
      height: 17px;
      accent-color: var(--teal);
      flex-shrink: 0;
      margin-top: 1px;
      cursor: pointer;
    }
    .terms-wrap label {
      font-size: 13px;
      color: #64748b;
      line-height: 1.55;
      cursor: pointer;
    }
    .terms-wrap label a { color: var(--teal-dark); font-weight: 600; text-decoration: none; }
    .terms-wrap label a:hover { text-decoration: underline; }

    /* Submit button */
    .btn-signup {
      width: 100%;
      padding: 14px;
      font-size: 15px;
      font-weight: 700;
      font-family: 'Inter', sans-serif;
      color: #fff;
      background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
      border: none;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 20px rgba(10,191,138,0.35);
      transition: transform 0.18s, box-shadow 0.18s, opacity 0.2s;
    }
    .btn-signup:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(10,191,138,0.45); }
    .btn-signup:active { transform: scale(0.97); }
    .btn-signup:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }
    .btn-signup svg { width: 18px; height: 18px; }

    .signin-link {
      display: block;
      text-align: center;
      margin-top: 16px;
      font-size: 13.5px;
      color: #64748b;
    }
    .signin-link a { color: var(--teal-dark); font-weight: 600; text-decoration: none; }
    .signin-link a:hover { text-decoration: underline; }

    /* Responsive */
    @media (max-width: 600px) {
      .signup-topbar { padding: 12px 16px; }
      .signup-card-header { padding: 28px 20px 24px; }
      .signup-form-body { padding: 20px 20px 28px; }
      .signup-progress { padding: 16px 20px 0; }
      .field-row { grid-template-columns: 1fr; }
      .header-text h1 { font-size: 22px; }
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <div class="signup-topbar">
    <a href="/" class="topbar-logo">Stay<span>Andaman</span></a>
    <div class="topbar-signin">Already have an account? <a href="/user/login">Sign In</a></div>
  </div>

  <!-- PAGE -->
  <div class="signup-page">
    <div class="signup-card">

      <!-- HEADER -->
      <div class="signup-card-header">
        <div class="header-content">
          <div class="header-text">
            <h1>Create Your Account</h1>
            <p>Join thousands of travellers exploring Andaman.<br>
              Already a member? <a href="/user/login">Sign in &rarr;</a>
            </p>
          </div>

          <!-- Avatar Upload -->
          <div class="avatar-upload-zone">
            <div class="avatar-circle" id="avatar-circle" onclick="document.getElementById('avatar-file-input').click()" title="Upload photo (optional)">
              <img id="avatar-preview-img" alt="Your photo">
              <svg id="avatar-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <div class="avatar-edit-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
              </div>
            </div>
            <span class="avatar-label">PHOTO (OPT.)</span>
            <input type="file" id="avatar-file-input" accept="image/*" style="display:none;">
          </div>
        </div>
      </div>

      <!-- PROGRESS -->
      <div class="signup-progress">
        <div class="progress-row">
          <span class="progress-label">Profile Completion</span>
          <span class="progress-pct" id="progress-pct">0%</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" id="progress-fill"></div>
        </div>
      </div>

      <!-- FORM BODY -->
      <div class="signup-form-body">

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-box alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <%= error %>
        </div>
        <% } %>

        <form id="signup-form" action="/user/signup" method="POST">
          <% if (typeof redirect !== 'undefined' && redirect) { %>
            <input type="hidden" name="redirect" value="<%= redirect %>">
          <% } %>
          <input type="hidden" name="avatar" id="avatar-data" value="">

          <!-- PERSONAL INFO SECTION -->
          <div class="form-section-label">Personal Information</div>

          <div class="field-row">
            <!-- First Name -->
            <div class="field-group" id="firstname-group">
              <label class="field-label" for="firstname-input">First Name <span class="field-required">*</span></label>
              <div class="field-input-wrap">
                <input type="text" class="field-input" id="firstname-input" name="firstName" placeholder="e.g. Rimi" required
                  value="<%= typeof oldValues !== 'undefined' && oldValues.firstName ? oldValues.firstName : '' %>">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div class="field-error-msg">First name is required</div>
            </div>

            <!-- Last Name -->
            <div class="field-group" id="lastname-group">
              <label class="field-label" for="lastname-input">Last Name <span class="field-required">*</span></label>
              <div class="field-input-wrap">
                <input type="text" class="field-input" id="lastname-input" name="lastName" placeholder="e.g. Dutta" required
                  value="<%= typeof oldValues !== 'undefined' && oldValues.lastName ? oldValues.lastName : '' %>">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div class="field-error-msg">Last name is required</div>
            </div>
          </div>

          <!-- CONTACT SECTION -->
          <div class="form-section-label" style="margin-top:8px;">Contact Details</div>

          <div class="field-row">
            <!-- Email -->
            <div class="field-group" id="email-group">
              <label class="field-label" for="email-input">Email Address <span class="field-required">*</span></label>
              <div class="field-input-wrap">
                <input type="email" class="field-input" id="email-input" name="email" placeholder="yourname@gmail.com" required autocomplete="email"
                  value="<%= typeof oldValues !== 'undefined' && oldValues.email ? oldValues.email : '' %>">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div class="field-error-msg">A valid email is required</div>
            </div>

            <!-- Phone -->
            <div class="field-group" id="phone-group">
              <label class="field-label" for="phone-input">Phone Number <span class="field-required">*</span></label>
              <div class="field-input-wrap">
                <input type="tel" class="field-input" id="phone-input" name="phone" placeholder="10-digit mobile number" required
                  value="<%= typeof oldValues !== 'undefined' && oldValues.phone ? oldValues.phone : '' %>">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.19 12 19.79 19.79 0 0 1 1.12 3.38 2 2 0 0 1 3.1 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div class="field-error-msg">Phone number is required</div>
            </div>
          </div>

          <!-- PROFILE SECTION -->
          <div class="form-section-label" style="margin-top:8px;">Profile Details</div>

          <div class="field-row">
            <!-- Gender -->
            <div class="field-group" id="gender-group">
              <label class="field-label" for="gender-input">Gender <span class="field-required">*</span></label>
              <div class="field-input-wrap">
                <select class="field-select field-input" id="gender-input" name="gender" required>
                  <option value="" disabled selected hidden></option>
                  <option value="Male" <%= typeof oldValues !== 'undefined' && oldValues.gender === 'Male' ? 'selected' : '' %>>Male</option>
                  <option value="Female" <%= typeof oldValues !== 'undefined' && oldValues.gender === 'Female' ? 'selected' : '' %>>Female</option>
                  <option value="Other" <%= typeof oldValues !== 'undefined' && oldValues.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <svg class="select-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
              <div class="field-error-msg">Please select a gender</div>
            </div>

            <!-- Date of Birth -->
            <div class="field-group" id="dob-group">
              <label class="field-label" for="dob-input">Date of Birth</label>
              <div class="field-input-wrap">
                <input type="<%= typeof oldValues !== 'undefined' && oldValues.dateOfBirth ? 'date' : 'text' %>"
                  class="field-input" id="dob-input" name="dateOfBirth" placeholder=" "
                  onfocus="(this.type='date')" onblur="if(!this.value) this.type='text'"
                  value="<%= typeof oldValues !== 'undefined' && oldValues.dateOfBirth ? oldValues.dateOfBirth : '' %>">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
            </div>
          </div>

          <!-- City -->
          <div class="field-row single" style="margin-bottom:20px;">
            <div class="field-group" id="city-group">
              <label class="field-label" for="city-input">City / Hometown</label>
              <div class="field-input-wrap">
                <input type="text" class="field-input" id="city-input" name="city" placeholder="Where are you from?"
                  value="<%= typeof oldValues !== 'undefined' && oldValues.city ? oldValues.city : '' %>">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
            </div>
          </div>

          <!-- Email note -->
          <div style="background: rgba(10,191,138,0.06); border: 1px solid rgba(10,191,138,0.2); border-radius: 10px; padding: 10px 14px; font-size: 12.5px; color: #0d7a55; margin-bottom: 20px; display: flex; align-items: flex-start; gap: 8px;">
            <svg style="width:15px;height:15px;flex-shrink:0;margin-top:1px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span><strong>Future logins are email-only!</strong> After signing up, you'll only need your email address to sign back in — no password required.</span>
          </div>

          <!-- Terms -->
          <div class="terms-wrap">
            <input type="checkbox" id="terms-check" required>
            <label for="terms-check">I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a> of StayAndaman.</label>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn-signup" id="btn-signup" disabled>
            Create My Account
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </button>
        </form>

        <p class="signin-link">Already have an account? <a href="/user/login">Sign in here</a></p>

      </div>
    </div>
  </div>

  <script src="/js/auth.js"></script>
  <script>
    // Avatar preview
    const avatarFileInput = document.getElementById('avatar-file-input');
    const avatarPreviewImg = document.getElementById('avatar-preview-img');
    const avatarPlaceholder = document.getElementById('avatar-placeholder');
    const avatarDataInput = document.getElementById('avatar-data');

    if (avatarFileInput) {
      avatarFileInput.addEventListener('change', function() {
        const file = this.files[0];
        if (!file) return;
        if (file.size > 2 * 1024 * 1024) {
          alert('Image must be under 2MB');
          return;
        }
        const reader = new FileReader();
        reader.onload = function(e) {
          avatarPreviewImg.src = e.target.result;
          avatarPreviewImg.style.display = 'block';
          if (avatarPlaceholder) avatarPlaceholder.style.display = 'none';
          if (avatarDataInput) avatarDataInput.value = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    // Progress bar & submit enable
    const signupForm = document.getElementById('signup-form');
    const progressFill = document.getElementById('progress-fill');
    const progressPct = document.getElementById('progress-pct');
    const submitBtn = document.getElementById('btn-signup');
    const termsCheck = document.getElementById('terms-check');

    function updateProgress() {
      const requiredInputs = signupForm.querySelectorAll('[required]:not(input[type="checkbox"])');
      let filled = 0;
      requiredInputs.forEach(el => {
        if (el.value.trim()) filled++;
      });
      const total = requiredInputs.length;
      const pct = total > 0 ? Math.round((filled / total) * 100) : 0;

      progressFill.style.width = pct + '%';
      progressPct.textContent = pct + '%';

      // Enable submit only if all required fields filled AND terms checked
      submitBtn.disabled = !(pct === 100 && termsCheck.checked);
    }

    signupForm.addEventListener('input', updateProgress);
    signupForm.addEventListener('change', updateProgress);
    termsCheck.addEventListener('change', updateProgress);

    // Loading state on submit
    signupForm.addEventListener('submit', function(e) {
      if (!submitBtn.disabled) {
        submitBtn.innerHTML = `<span style="display:inline-block;width:18px;height:18px;border:2.5px solid rgba(255,255,255,0.4);border-top-color:#fff;border-radius:50%;animation:spin 0.8s linear infinite;"></span> Creating account...`;
        submitBtn.style.opacity = '0.85';
      }
    });

    const s = document.createElement('style');
    s.innerHTML = '@keyframes spin { to { transform: rotate(360deg); } }';
    document.head.appendChild(s);

    setTimeout(updateProgress, 80);
  </script>
</body>
</html>

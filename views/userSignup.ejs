<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/images/logo-favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Create your Stayandaman account to explore 800+ verified stays across hotels, lodges, and rentals.">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/auth.css">
  <title>Create Account — Stayandaman</title>
</head>
<body class="auth-center-body">

  <!-- Logo placed absolutely at the top-left on desktops -->
  <a href="/" class="auth-left-logo">Stay<span>Andaman</span></a>

  <div class="auth-center-container">

    <div class="auth-center-card">
      
      <!-- Header Row with Profile Photo -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px; position: relative;">
        <div>
          <h2 class="auth-title" style="font-size: 26px; margin: 0; text-align: left;">Create Account</h2>
          <p class="auth-subtitle" style="margin: 4px 0 0 0; text-align: left;">Already have an account? <a href="/user/login">Sign In &rarr;</a></p>
        </div>
        
        <!-- Compact Avatar Upload on the right -->
        <div class="form-group" id="avatar-group" style="margin: 0; display: flex; flex-direction: column; align-items: center;">
          <div class="avatar-upload-compact" id="avatar-upload-zone" style="width: 64px; height: 64px; border-width: 2px;">
            <div class="avatar-preview-box">
              <img id="avatar-preview-img" alt="Avatar Preview">
              <svg id="avatar-placeholder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 28px; height: 28px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="avatar-edit-badge" style="width: 20px; height: 20px; border-width: 1.5px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width: 8px; height: 8px;"><path d="M12 5v14M5 12h14"/></svg>
            </div>
          </div>
          <span style="font-size: 9px; font-weight: 600; color: var(--text-soft); margin-top: 4px;">Photo (Optional)</span>
          <input type="file" id="avatar-file-input" accept="image/*" style="display:none;">
          <div class="field-error" style="text-align: center; font-size: 10px; position: absolute; top: 100%; right: 0; width: 120px;">Invalid file</div>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="signup-progress" style="margin-bottom: 16px;">
        <div class="signup-progress-info" style="margin-bottom: 4px;">
          <span class="signup-progress-label" style="font-size: 12px;">Profile Completion</span>
          <span class="signup-progress-pct" id="progress-pct" style="font-size: 12px;">0%</span>
        </div>
        <div class="signup-progress-track" style="height: 4px;">
          <div class="signup-progress-fill" id="progress-fill"></div>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-alert auth-alert-error" style="margin-bottom: 16px; padding: 12px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <%= error %>
      </div>
      <% } %>

      <form id="signup-form" class="auth-form" action="/user/signup" method="POST" style="gap: 12px;">
        <input type="hidden" name="avatar" id="avatar-data" value="">

          <!-- Row 1: First Name + Last Name -->
          <div class="form-group-row">
            <div class="form-group" id="firstname-group">
              <div class="input-wrapper">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <input type="text" class="form-input" id="firstname-input" name="firstName" placeholder=" " required value="<%= typeof oldValues !== 'undefined' && oldValues.firstName ? oldValues.firstName : '' %>">
                <label class="form-label" for="firstname-input">First Name *</label>
                <div class="input-focus-line"></div>
              </div>
              <div class="field-error">First name is required</div>
            </div>

            <div class="form-group" id="lastname-group">
              <div class="input-wrapper">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <input type="text" class="form-input" id="lastname-input" name="lastName" placeholder=" " required value="<%= typeof oldValues !== 'undefined' && oldValues.lastName ? oldValues.lastName : '' %>">
                <label class="form-label" for="lastname-input">Last Name *</label>
                <div class="input-focus-line"></div>
              </div>
              <div class="field-error">Last name is required</div>
            </div>
          </div>

          <!-- Row 2: Email + Phone -->
          <div class="form-group-row">
            <div class="form-group" id="email-group">
              <div class="input-wrapper">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <input type="email" class="form-input" id="email-input" name="email" placeholder=" " required value="<%= typeof oldValues !== 'undefined' && oldValues.email ? oldValues.email : '' %>">
                <label class="form-label" for="email-input">Email *</label>
                <div class="input-focus-line"></div>
              </div>
              <div class="field-error">A valid email is required</div>
            </div>

            <div class="form-group" id="phone-group">
              <div class="input-wrapper">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <input type="tel" class="form-input" id="phone-input" name="phone" placeholder=" " required value="<%= typeof oldValues !== 'undefined' && oldValues.phone ? oldValues.phone : '' %>">
                <label class="form-label" for="phone-input">Phone *</label>
                <div class="input-focus-line"></div>
              </div>
              <div class="field-error">Phone number is required</div>
            </div>
          </div>

          <!-- Row 3: Gender + Date of Birth -->
          <div class="form-group-row">
            <div class="form-group" id="gender-group">
              <div class="input-wrapper">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <select class="form-input" id="gender-input" name="gender" required style="padding-right: 40px;">
                  <option value="" disabled selected hidden></option>
                  <option value="Male" <%= typeof oldValues !== 'undefined' && oldValues.gender === 'Male' ? 'selected' : '' %>>Male</option>
                  <option value="Female" <%= typeof oldValues !== 'undefined' && oldValues.gender === 'Female' ? 'selected' : '' %>>Female</option>
                  <option value="Other" <%= typeof oldValues !== 'undefined' && oldValues.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
                <label class="form-label" for="gender-input">Gender *</label>
                <div class="input-focus-line"></div>
                <svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
              <div class="field-error">Please select a gender</div>
            </div>

            <div class="form-group" id="dob-group">
              <div class="input-wrapper">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <input type="<%= typeof oldValues !== 'undefined' && oldValues.dateOfBirth ? 'date' : 'text' %>" class="form-input" id="dob-input" name="dateOfBirth" placeholder=" " onfocus="(this.type='date')" onblur="if(!this.value) this.type='text'" value="<%= typeof oldValues !== 'undefined' && oldValues.dateOfBirth ? oldValues.dateOfBirth : '' %>">
                <label class="form-label" for="dob-input">Date of Birth</label>
                <div class="input-focus-line"></div>
              </div>
            </div>
          </div>

          <!-- Row 4: City -->
          <div class="form-group" id="city-group">
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <input type="text" class="form-input" id="city-input" name="city" placeholder=" " value="<%= typeof oldValues !== 'undefined' && oldValues.city ? oldValues.city : '' %>">
              <label class="form-label" for="city-input">City</label>
              <div class="input-focus-line"></div>
            </div>
          </div>

          <!-- Terms -->
          <div class="terms-row">
            <input type="checkbox" id="terms-check" required>
            <label for="terms-check">I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></label>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn-auth" disabled>
            Create Account
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </button>

          <div class="auth-links">
            <a href="/user/login">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
              Already have an account? Sign In
            </a>
          </div>

        </form>
      </div>
    </div>

  <script src="/js/auth.js"></script>
  
  <script>
    // Lazy load fade-in
    document.querySelectorAll('img').forEach(img => {
      if (img.complete) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => img.classList.add('loaded'));
        img.addEventListener('error', () => {
          img.src = 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80&fit=crop';
          img.classList.add('loaded');
        });
      }
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/images/logo-favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Stayandaman — Your perfect stay, simplified. Explore premium hotels, cozy lodges, and private rentals all in one place.">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/landing.css">
  <title>Welcome to Stayandaman — Your Perfect Stay, Simplified</title>
</head>
<body class="landing-body" style="background: none; min-height: 100vh; padding: 0; margin: 0;">
  <div style="
    background-image: 
      linear-gradient(135deg,rgba(26,31,54,0.88),rgba(10,191,138,0.7)),
      url('https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?w=1600&q=85&fit=crop');
    background-size: cover;
    background-position: center;
    min-height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  ">

  <!-- ===== Navigation ===== -->
  <nav class="landing-nav">
    <a href="/" class="landing-nav-logo">
      <svg class="landing-nav-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M9 12l2 2 4-4" stroke-width="2"/>
      </svg>
      Stay<span>Andaman</span>
    </a>
    <div class="landing-nav-actions">
      <% if (locals.user) { %>
        <span style="color: rgba(255,255,255,0.75); font-size: 14px; font-weight: 500; margin-right: 8px;">Hello, <%= user.fullName.split(' ')[0] %></span>
        <a href="/home" class="btn-nav-signup">Go to Home</a>
      <% } else if (locals.admin) { %>
        <span style="color: rgba(255,255,255,0.75); font-size: 14px; font-weight: 500; margin-right: 8px;">Hello, Admin <%= admin.fullName.split(' ')[0] %></span>
        <a href="/admin/dashboard" class="btn-nav-signup">Go to Dashboard</a>
      <% } else { %>
        <a href="/user/login" class="btn-nav-signin">Sign In</a>
        <a href="/user/signup" class="btn-nav-signup">Get Started</a>
      <% } %>
    </div>
  </nav>

  <!-- Floating Dots Pattern -->
  <div class="landing-dots" aria-hidden="true">
    <div class="landing-dot" style="top:10%;left:15%;--dur:7s;--delay:0s"></div>
    <div class="landing-dot" style="top:25%;left:80%;--dur:5s;--delay:1s"></div>
    <div class="landing-dot" style="top:60%;left:10%;--dur:8s;--delay:2s"></div>
    <div class="landing-dot" style="top:75%;left:70%;--dur:6s;--delay:0.5s"></div>
    <div class="landing-dot" style="top:40%;left:50%;--dur:9s;--delay:3s"></div>
    <div class="landing-dot" style="top:85%;left:35%;--dur:7s;--delay:1.5s"></div>
    <div class="landing-dot" style="top:15%;left:60%;--dur:6s;--delay:2.5s"></div>
    <div class="landing-dot" style="top:50%;left:90%;--dur:8s;--delay:0.8s"></div>
  </div>

  <div class="landing-container">

    <!-- ===== Brand Header ===== -->
    <header class="landing-header">
      <div class="landing-logo">
        <!-- Shield Icon -->
        <svg class="landing-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4" stroke-width="2"/>
        </svg>
        <h1 class="landing-logo-text">Stay<span>Andaman</span></h1>
      </div>
      <p class="landing-tagline">Your Perfect Stay, Simplified</p>
      <p class="landing-subtitle">Hotels • Lodges • Rentals — all in one place</p>
    </header>

    <!-- ===== Portal Cards ===== -->
    <div class="landing-cards">

      <!-- HOTEL CARD -->
      <section class="portal-card card-hotel" id="hotel-card" onclick="navigateTo('<%= locals.user ? '/home/hotel' : '/user/login' %>')" style="background-image: linear-gradient(rgba(26,31,54,0.92),rgba(26,31,54,0.88)), url('https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80&fit=crop'); background-size: cover; background-position: center;">
        <div class="portal-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21h18"/>
            <path d="M9 21V9a3 3 0 0 1 6 0v12"/>
            <path d="M2 2h20v4H2z"/>
            <path d="M19 6v14"/>
            <path d="M5 6v14"/>
          </svg>
        </div>
        <h2 class="portal-card-title">Premium Hotels</h2>
        <p class="portal-card-desc">Experience luxury and world-class services at verified stays</p>
        <div class="portal-card-stats">
          <span>120+ Stays</span>
          <span class="stat-divider"></span>
          <span>Top Rated</span>
          <span class="stat-divider"></span>
          <span>Best Price</span>
        </div>
        <a href="<%= locals.user ? '/home/hotel' : '/user/login' %>" class="portal-card-btn" onclick="event.stopPropagation();">
          Explore Hotels
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </section>

      <!-- LODGE CARD -->
      <section class="portal-card card-lodge" id="lodge-card" onclick="navigateTo('<%= locals.user ? '/home/lodges' : '/user/login' %>')" style="background-image: linear-gradient(rgba(26,31,54,0.92),rgba(26,31,54,0.88)), url('https://images.unsplash.com/photo-1510798831971-661eb04b3739?w=800&q=80&fit=crop'); background-size: cover; background-position: center;">
        <div class="portal-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 22 12 5 5 22h14Z"/>
            <path d="M12 5v17"/>
            <path d="m14 12-2 2-2-2"/>
          </svg>
        </div>
        <h2 class="portal-card-title">Cozy Lodges</h2>
        <p class="portal-card-desc">Escape to nature in scenic, verified cabins and wilderness lodges</p>
        <div class="portal-card-stats">
          <span>80+ Stays</span>
          <span class="stat-divider"></span>
          <span>Nature Bound</span>
          <span class="stat-divider"></span>
          <span>Scenic Views</span>
        </div>
        <a href="<%= locals.user ? '/home/lodges' : '/user/login' %>" class="portal-card-btn" onclick="event.stopPropagation();">
          Explore Lodges
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </section>

      <!-- RENTAL CARD -->
      <section class="portal-card card-rental" id="rental-card" onclick="navigateTo('<%= locals.user ? '/home/rentals' : '/user/login' %>')" style="background-image: linear-gradient(rgba(26,31,54,0.92),rgba(26,31,54,0.88)), url('https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?w=800&q=80&fit=crop'); background-size: cover; background-position: center;">
        <div class="portal-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </div>
        <h2 class="portal-card-title">Private Rentals</h2>
        <p class="portal-card-desc">Enjoy space and privacy in premium apartments and beachfront villas</p>
        <div class="portal-card-stats">
          <span>60+ Stays</span>
          <span class="stat-divider"></span>
          <span>Private Space</span>
          <span class="stat-divider"></span>
          <span>Home Comforts</span>
        </div>
        <a href="<%= locals.user ? '/home/rentals' : '/user/login' %>" class="portal-card-btn" onclick="event.stopPropagation();">
          Explore Rentals
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </section>

    </div>

    <!-- ===== Trust Badges ===== -->
    <div class="landing-trust">
      <div class="trust-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Verified Properties
      </div>
      <div class="trust-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Best Price Guarantee
      </div>
      <div class="trust-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        24/7 Support
      </div>
      <div class="trust-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free Cancellation
      </div>
    </div>

  </div>

  <!-- Footer -->
  <footer class="landing-footer">
    © 2025 Stayandaman. All rights reserved.
  </footer>

  </div>

  <script>
    function navigateTo(url) {
      document.body.style.opacity = '0';
      document.body.style.transition = 'opacity 0.4s ease';
      setTimeout(() => { window.location.href = url; }, 400);
    }
  </script>
  
  <script>
    // Lazy load fade-in
    document.querySelectorAll('img').forEach(img => {
      if (img.complete) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => img.classList.add('loaded'));
        img.addEventListener('error', () => {
          img.src = 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80&fit=crop';
          img.classList.add('loaded');
        });
      }
    });
  </script>
</body>
</html>

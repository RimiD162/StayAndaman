<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/images/logo-favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sign in to StayAndaman with just your email — no password needed. Book premium stays across Andaman islands instantly.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <title>Sign In — StayAndaman</title>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --teal: #0abf8a;
      --teal-dark: #07a876;
      --navy: #0d1b2a;
      --navy-mid: #1a2e45;
      --gold: #f5a623;
      --white: #ffffff;
      --off-white: #f8fafc;
      --text-muted: rgba(255,255,255,0.55);
      --card-bg: rgba(255,255,255,0.97);
      --shadow-xl: 0 32px 80px rgba(0,0,0,0.25);
    }

    html, body {
      height: 100%;
      font-family: 'Inter', system-ui, sans-serif;
      overflow: hidden;
    }

    .auth-screen {
      display: flex;
      height: 100vh;
      width: 100vw;
    }

    /* LEFT PANEL */
    .auth-left {
      flex: 1.1;
      position: relative;
      background: var(--navy);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 60px;
      overflow: hidden;
    }

    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.35;
      animation: blobPulse 8s ease-in-out infinite alternate;
    }
    .blob-1 { width: 420px; height: 420px; background: var(--teal); top: -80px; left: -120px; animation-delay: 0s; }
    .blob-2 { width: 300px; height: 300px; background: #1e6fa8; bottom: -60px; right: -60px; animation-delay: 2s; }
    .blob-3 { width: 200px; height: 200px; background: var(--gold); top: 55%; left: 50%; animation-delay: 4s; opacity: 0.18; }
    @keyframes blobPulse {
      from { transform: scale(1) rotate(0deg); }
      to   { transform: scale(1.15) rotate(15deg); }
    }

    .auth-left-content {
      position: relative;
      z-index: 2;
      text-align: center;
      max-width: 420px;
    }

    .auth-left-logo {
      font-family: 'Playfair Display', serif;
      font-size: 28px;
      font-weight: 800;
      color: #fff;
      text-decoration: none;
      display: inline-block;
      margin-bottom: 48px;
      letter-spacing: -0.5px;
    }
    .auth-left-logo span { color: var(--teal); }

    .auth-left-tagline {
      font-family: 'Playfair Display', serif;
      font-size: 42px;
      font-weight: 700;
      color: #fff;
      line-height: 1.2;
      margin-bottom: 20px;
    }
    .auth-left-tagline .hl { color: var(--teal); }

    .auth-left-desc {
      font-size: 15px;
      color: var(--text-muted);
      line-height: 1.75;
      margin-bottom: 40px;
    }

    .auth-feature-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      text-align: left;
    }

    .auth-feature-item {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      color: rgba(255,255,255,0.8);
    }

    .auth-feature-icon {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(10,191,138,0.18);
      border: 1px solid rgba(10,191,138,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .auth-feature-icon svg {
      width: 16px;
      height: 16px;
      color: var(--teal);
    }

    /* RIGHT PANEL */
    .auth-right {
      flex: 0.9;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 48px 40px;
      background: var(--off-white);
      overflow-y: auto;
    }

    .auth-card {
      width: 100%;
      max-width: 420px;
      background: var(--card-bg);
      border-radius: 24px;
      padding: 44px 40px;
      box-shadow: var(--shadow-xl);
      animation: slideUp 0.5s cubic-bezier(0.22,1,0.36,1);
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(32px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .auth-card-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(10,191,138,0.1);
      border: 1px solid rgba(10,191,138,0.25);
      color: var(--teal-dark);
      font-size: 12px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 999px;
      margin-bottom: 20px;
      letter-spacing: 0.5px;
    }
    .auth-card-badge svg { width: 14px; height: 14px; }

    .auth-card-title {
      font-family: 'Playfair Display', serif;
      font-size: 30px;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 6px;
      line-height: 1.2;
    }

    .auth-card-subtitle {
      font-size: 14px;
      color: #64748b;
      margin-bottom: 28px;
      line-height: 1.6;
    }
    .auth-card-subtitle a {
      color: var(--teal-dark);
      font-weight: 600;
      text-decoration: none;
    }
    .auth-card-subtitle a:hover { text-decoration: underline; }

    .alert-box {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 13.5px;
      line-height: 1.5;
      margin-bottom: 20px;
    }
    .alert-box svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
    .alert-error  { background: #fff0f0; color: #c0392b; border: 1px solid rgba(192,57,43,0.2); }
    .alert-success { background: #f0fdf8; color: #0d7a55; border: 1px solid rgba(10,191,138,0.25); }

    .field-group { margin-bottom: 18px; }
    .field-label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 7px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }
    .field-input-wrap { position: relative; }
    .field-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: #94a3b8;
      pointer-events: none;
      transition: color 0.2s;
    }
    .field-input {
      width: 100%;
      padding: 13px 14px 13px 44px;
      font-size: 15px;
      font-family: 'Inter', sans-serif;
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      color: var(--navy);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .field-input:focus {
      border-color: var(--teal);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(10,191,138,0.12);
    }
    .field-input-wrap:focus-within .field-icon { color: var(--teal); }
    .field-input::placeholder { color: #b0bec5; }
    .field-error-msg {
      font-size: 11.5px;
      color: #e53e3e;
      margin-top: 5px;
      padding-left: 2px;
      display: none;
    }
    .field-group.has-error .field-input { border-color: #fc8181; background: #fff5f5; }
    .field-group.has-error .field-error-msg { display: block; }

    .options-row {
      display: flex;
      align-items: center;
      margin-bottom: 24px;
    }
    .remember-me {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13.5px;
      color: #64748b;
      cursor: pointer;
    }
    .remember-me input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--teal);
      cursor: pointer;
    }

    .btn-signin {
      width: 100%;
      padding: 14px;
      font-size: 15px;
      font-weight: 700;
      font-family: 'Inter', sans-serif;
      color: #fff;
      background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
      border: none;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 20px rgba(10,191,138,0.35);
      transition: transform 0.18s, box-shadow 0.18s;
      margin-bottom: 20px;
    }
    .btn-signin:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(10,191,138,0.45); }
    .btn-signin:active { transform: scale(0.97); }
    .btn-signin svg { width: 18px; height: 18px; }

    .auth-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #cbd5e1;
      font-size: 12.5px;
      font-weight: 500;
      margin-bottom: 20px;
    }
    .auth-divider::before, .auth-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #e2e8f0;
    }

    .signup-cta { text-align: center; }
    .signup-cta p { font-size: 13.5px; color: #64748b; margin-bottom: 10px; }
    .btn-signup-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 600;
      color: var(--navy);
      text-decoration: none;
      padding: 11px 24px;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      background: #fff;
      transition: all 0.2s;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .btn-signup-link:hover {
      border-color: var(--teal);
      color: var(--teal-dark);
      box-shadow: 0 4px 16px rgba(10,191,138,0.15);
      transform: translateY(-1px);
    }
    .btn-signup-link svg { width: 16px; height: 16px; }

    .back-home {
      display: block;
      text-align: center;
      margin-top: 20px;
      font-size: 13px;
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.2s;
    }
    .back-home:hover { color: var(--teal-dark); }

    .email-note {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(10,191,138,0.06);
      border: 1px solid rgba(10,191,138,0.2);
      border-radius: 8px;
      padding: 9px 12px;
      font-size: 12.5px;
      color: #0d7a55;
      margin-bottom: 18px;
    }
    .email-note svg { width: 15px; height: 15px; flex-shrink: 0; }

    @media (max-width: 820px) {
      html, body { overflow: auto; }
      .auth-screen { flex-direction: column; height: auto; min-height: 100vh; }
      .auth-left { flex: none; padding: 40px 30px; min-height: 240px; }
      .auth-left-tagline { font-size: 28px; }
      .auth-left-desc, .auth-feature-list { display: none; }
      .auth-right { flex: none; padding: 32px 20px; }
      .auth-card { padding: 32px 24px; }
    }
  </style>
</head>
<body>
  <div class="auth-screen">

    <!-- LEFT PANEL -->
    <div class="auth-left">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>

      <div class="auth-left-content">
        <a href="/" class="auth-left-logo">Stay<span>Andaman</span></a>

        <h2 class="auth-left-tagline">
          Welcome<br>back to<br><span class="hl">Paradise</span> &#127796;
        </h2>
        <p class="auth-left-desc">
          Sign in instantly with just your email.<br>
          No password, no hassle — just your next adventure.
        </p>

        <div class="auth-feature-list">
          <div class="auth-feature-item">
            <div class="auth-feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span>800+ verified stays across Andaman islands</span>
          </div>
          <div class="auth-feature-item">
            <div class="auth-feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <span>Instant booking confirmation, no waiting</span>
          </div>
          <div class="auth-feature-item">
            <div class="auth-feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span>Secure &amp; private — no password ever stored</span>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT FORM PANEL -->
    <div class="auth-right">
      <div class="auth-card">

        <div class="auth-card-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Returning Visitor
        </div>

        <h1 class="auth-card-title">Sign In</h1>
        <p class="auth-card-subtitle">
          New here? <a href="/user/signup<%= typeof redirect !== 'undefined' && redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>">Create a free account &rarr;</a>
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-box alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <div style="flex:1;">
            <div><%= error %></div>
            <% if (typeof notFoundEmail !== 'undefined' && notFoundEmail) { %>
              <div style="margin-top: 8px;">
                <a href="/user/signup?email=<%= encodeURIComponent(notFoundEmail) %><%= typeof redirect !== 'undefined' && redirect ? '&redirect=' + encodeURIComponent(redirect) : '' %>" style="display:inline-flex; align-items:center; gap:5px; background: rgba(192,57,43,0.12); color:#c0392b; font-weight:700; font-size:12.5px; padding:5px 10px; border-radius:6px; text-decoration:none;">
                  ✨ Click here to create an account &rarr;
                </a>
              </div>
            <% } %>
          </div>
        </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert-box alert-success">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <div><%- success %></div>
        </div>
        <% } %>

        <div class="email-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Just enter the email you used when signing up — no password needed!
        </div>

        <form id="login-form" action="/user/login" method="POST">
          <% if (typeof redirect !== 'undefined' && redirect) { %>
            <input type="hidden" name="redirect" value="<%= redirect %>">
          <% } %>

          <div class="field-group" id="email-group">
            <label class="field-label" for="login-email">Your Email Address</label>
            <div class="field-input-wrap">
              <input
                type="email"
                id="login-email"
                name="email"
                class="field-input"
                placeholder="e.g. yourname@gmail.com"
                autocomplete="email"
                required
                value="<%= typeof oldValues !== 'undefined' && oldValues.email ? oldValues.email : '' %>"
              >
              <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="field-error-msg">Please enter a valid email address.</div>
          </div>

          <div class="options-row">
            <label class="remember-me">
              <input type="checkbox" name="rememberMe" value="true">
              Keep me signed in for 7 days
            </label>
          </div>

          <button type="submit" class="btn-signin" id="btn-login">
            Sign In
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </button>
        </form>

        <div class="auth-divider">or</div>

        <div class="signup-cta">
          <p>First time visiting StayAndaman?</p>
          <a href="/user/signup<%= typeof redirect !== 'undefined' && redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" class="btn-signup-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            Create Your Free Account
          </a>
        </div>

        <a href="/" class="back-home">&#8592; Back to Home</a>

      </div>
    </div>

  </div>

  <script>
    const loginForm = document.getElementById('login-form');
    const emailGroup = document.getElementById('email-group');
    const emailInput = document.getElementById('login-email');

    emailInput.addEventListener('input', function() {
      emailGroup.classList.remove('has-error');
    });

    loginForm.addEventListener('submit', function(e) {
      const val = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!val || !emailRegex.test(val)) {
        e.preventDefault();
        emailGroup.classList.add('has-error');
        emailInput.focus();
        return;
      }
      const btn = document.getElementById('btn-login');
      btn.style.opacity = '0.85';
      btn.style.cursor = 'not-allowed';
      btn.innerHTML = `<span style="display:inline-block;width:18px;height:18px;border:2.5px solid rgba(255,255,255,0.4);border-top-color:#fff;border-radius:50%;animation:spin 0.8s linear infinite;"></span> Signing you in...`;
    });

    const s = document.createElement('style');
    s.innerHTML = '@keyframes spin { to { transform: rotate(360deg); } }';
    document.head.appendChild(s);
  </script>
</body>
</html>

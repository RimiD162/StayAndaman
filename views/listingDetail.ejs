  <!-- ===== LIVE PRICING CALCULATION JS ===== -->
  <script>
    const pricePerNight = parseFloat(document.getElementById('price-per-night').textContent);
    
    let stayDetails = {
      checkIn: null,
      checkOut: null,
      nights: 1,
      guests: 1,
      subtotal: pricePerNight,
      tax: 0,
      total: pricePerNight
    };

    // Set check-in date limits and initialize default dates (Tomorrow -> Day After)
    document.addEventListener('DOMContentLoaded', () => {
      const today = new Date();
      const todayStr = today.toISOString().split('T')[0];
      
      const tomorrow = new Date(today);
      tomorrow.setDate(today.getDate() + 1);
      const tomorrowStr = tomorrow.toISOString().split('T')[0];
      
      const dayAfter = new Date(today);
      dayAfter.setDate(today.getDate() + 2);
      const dayAfterStr = dayAfter.toISOString().split('T')[0];

      const checkinEl = document.getElementById('check-in-date');
      const checkoutEl = document.getElementById('check-out-date');
      
      if (checkinEl) {
        checkinEl.min = todayStr;
        if (!checkinEl.value) checkinEl.value = tomorrowStr;
      }
      if (checkoutEl) {
        checkoutEl.min = tomorrowStr;
        if (!checkoutEl.value) checkoutEl.value = dayAfterStr;
      }
      
      onDatesChanged();
    });

    function onDatesChanged() {
      const checkinEl = document.getElementById('check-in-date');
      const checkoutEl = document.getElementById('check-out-date');
      const openBtn = document.getElementById('btn-open-booking');
      
      if (!checkinEl || !checkoutEl) return;

      const checkinStr = checkinEl.value;
      const checkoutStr = checkoutEl.value;
      
      if (!checkinStr) return;
      
      // Update check-out min date constraint
      const checkinDate = new Date(checkinStr);
      checkinDate.setDate(checkinDate.getDate() + 1); // Checkout must be at least 1 day after
      checkoutEl.min = checkinDate.toISOString().split('T')[0];

      if (!checkoutStr) return;

      const date1 = new Date(checkinStr);
      const date2 = new Date(checkoutStr);
      
      if (date2 <= date1) {
        // Invalid date range
        document.getElementById('breakdown-area').style.display = 'none';
        document.getElementById('select-dates-hint').style.display = 'block';
        document.getElementById('select-dates-hint').innerText = "Check-out date must be after check-in date!";
        document.getElementById('select-dates-hint').style.color = 'var(--danger)';
        if (openBtn) openBtn.disabled = true;
        return;
      }

      // Valid range - calculate stay duration
      const diffTime = Math.abs(date2 - date1);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) || 1;
      
      stayDetails.checkIn = checkinStr;
      stayDetails.checkOut = checkoutStr;
      stayDetails.nights = diffDays;
      stayDetails.subtotal = diffDays * pricePerNight;
      stayDetails.tax = 0;
      stayDetails.total = stayDetails.subtotal;

      // Update Card Breakdown UI
      document.getElementById('subtotal-calc-label').innerText = `${diffDays} night${diffDays > 1 ? 's' : ''} = ₹${pricePerNight.toLocaleString('en-IN')}/night`;
      document.getElementById('subtotal-calc-val').innerText = `₹${stayDetails.subtotal.toLocaleString('en-IN')}`;
      document.getElementById('total-amount-val').innerText = `₹${stayDetails.total.toLocaleString('en-IN')}`;
      
      // Update Button label
      if (openBtn) {
        openBtn.innerText = `🔒 Book Now — ₹${stayDetails.total.toLocaleString('en-IN')}`;
        openBtn.disabled = false;
      }
      
      document.getElementById('breakdown-area').style.display = 'block';
      document.getElementById('select-dates-hint').style.display = 'none';
      
      // Update Modal Form pre-fill values
      const modalIn = document.getElementById('modal-checkin-field');
      const modalOut = document.getElementById('modal-checkout-field');
      if (modalIn) modalIn.value = checkinStr;
      if (modalOut) {
        modalOut.value = checkoutStr;
        const nextDay = new Date(checkinStr);
        nextDay.setDate(nextDay.getDate() + 1);
        modalOut.min = nextDay.toISOString().split('T')[0];
      }
    }

    function onGuestsChanged() {
      const select = document.getElementById('guest-count');
      stayDetails.guests = parseInt(select.value) || 1;
      
      // Update Modal dropdown
      const modalGuests = document.getElementById('modal-guests-field');
      if (modalGuests) modalGuests.value = select.value;
    }
  </script>

  <!-- ===== MODAL HANDLERS & VALIDATIONS ===== -->
  <script>
    function openBookingModal() {
      // Ensure valid dates are populated
      const checkinEl = document.getElementById('check-in-date');
      const checkoutEl = document.getElementById('check-out-date');
      if (!checkinEl.value || !checkoutEl.value || stayDetails.nights <= 0) {
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(today.getDate() + 1);
        const dayAfter = new Date(today);
        dayAfter.setDate(today.getDate() + 2);
        checkinEl.value = tomorrow.toISOString().split('T')[0];
        checkoutEl.value = dayAfter.toISOString().split('T')[0];
        onDatesChanged();
      }

      // Populate and open modal freely
      document.getElementById('modal-summary-checkin').innerText = formatDateStr(stayDetails.checkIn);
      document.getElementById('modal-summary-checkout').innerText = formatDateStr(stayDetails.checkOut);
      document.getElementById('modal-summary-nights').innerText = stayDetails.nights;
      document.getElementById('modal-summary-guests').innerText = stayDetails.guests;
      document.getElementById('modal-summary-total').innerText = `₹${stayDetails.total.toLocaleString('en-IN')}`;
      
      // Update Payment Advance / Total Displays
      updatePaymentCalculations();

      // Trigger modal active class
      document.getElementById('booking-modal').classList.add('active');
      
      // Perform initial form validation check
      validateFormState();
    }

    function closeBookingModal() {
      document.getElementById('booking-modal').classList.remove('active');
    }

    function formatDateStr(dateStr) {
      if(!dateStr) return '—';
      const d = new Date(dateStr);
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return `${d.getDate()} ${months[d.getMonth()]}`;
    }

    // Modal forms sync date triggers back to main card details
    function syncDatesFromModal() {
      const checkin = document.getElementById('modal-checkin-field').value;
      const checkout = document.getElementById('modal-checkout-field').value;
      
      document.getElementById('check-in-date').value = checkin;
      document.getElementById('check-out-date').value = checkout;
      
      // Recalculate price fields
      onDatesChanged();
      
      // Update modal headers
      document.getElementById('modal-summary-checkin').innerText = formatDateStr(checkin);
      document.getElementById('modal-summary-checkout').innerText = formatDateStr(checkout);
      document.getElementById('modal-summary-nights').innerText = stayDetails.nights;
      document.getElementById('modal-summary-total').innerText = `₹${stayDetails.total.toLocaleString('en-IN')}`;
      
      updatePaymentCalculations();
      validateFormState();
    }

    function syncGuestsFromModal() {
      const val = document.getElementById('modal-guests-field').value;
      document.getElementById('guest-count').value = val;
      stayDetails.guests = parseInt(val);
      document.getElementById('modal-summary-guests').innerText = val;
      validateFormState();
    }

    // Payment calculations for Advance & Full
    function updatePaymentCalculations() {
      const total = stayDetails.total || 0;
      const advance = Math.round(total * 0.20);
      const balance = Math.round(total * 0.80);

      const upiBadge = document.getElementById('upi-pay-amount-badge');
      if (upiBadge) upiBadge.innerText = `₹${total.toLocaleString('en-IN')}`;

      const advEl = document.getElementById('partial-advance-val');
      if (advEl) advEl.innerText = `₹${advance.toLocaleString('en-IN')}`;

      const balEl = document.getElementById('partial-balance-val');
      if (balEl) balEl.innerText = `₹${balance.toLocaleString('en-IN')}`;

      const partialDesc = document.getElementById('partial-desc-text');
      if (partialDesc) partialDesc.innerText = `Pay 20% (₹${advance.toLocaleString('en-IN')}) now & rest ₹${balance.toLocaleString('en-IN')} at check-in.`;
    }

    // Custom Radio buttons style selection triggers
    function selectPaymentCard(cardEl, method) {
      document.querySelectorAll('.payment-radio-card').forEach(c => c.classList.remove('active'));
      cardEl.classList.add('active');
      const radio = cardEl.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      const onlineBox = document.getElementById('online-payment-details-box');
      const upiContent = document.getElementById('upi-method-content');
      const partialContent = document.getElementById('partial-method-content');

      if (method === 'UPI / Net Banking') {
        onlineBox.style.display = 'block';
        upiContent.style.display = 'block';
        partialContent.style.display = 'none';
      } else if (method === 'Pay Partial') {
        onlineBox.style.display = 'block';
        upiContent.style.display = 'block';
        partialContent.style.display = 'block';
      } else {
        onlineBox.style.display = 'none';
      }

      validateFormState();
    }

    function updateRadioSelection(radioInput) {
      const card = radioInput.closest('.payment-radio-card');
      if (card) selectPaymentCard(card, radioInput.value);
    }

    function chooseUpiApp(btnEl, appName) {
      document.querySelectorAll('.upi-app-btn').forEach(b => {
        b.classList.remove('active');
        b.style.border = '1.5px solid #cbd5e1';
        b.style.background = '#fff';
        b.style.color = '#475569';
      });
      btnEl.classList.add('active');
      btnEl.style.border = '1.5px solid #2563eb';
      btnEl.style.background = '#eff6ff';
      btnEl.style.color = '#1e40af';

      const vpa = document.getElementById('upi-vpa-input');
      if (vpa) {
        if (appName === 'GPay') vpa.value = 'user@okaxis';
        else if (appName === 'PhonePe') vpa.value = 'user@ybl';
        else if (appName === 'Paytm') vpa.value = 'user@paytm';
        else vpa.value = 'user@upi';
      }
    }

    // Form validations
    function validateField(input) {
      const group = input.closest('.booking-field-group');
      if (!group) return;
      
      let isValid = true;
      if (input.required && !input.value.trim()) {
        isValid = false;
      }
      
      if (input.type === 'email' && input.value.trim()) {
        const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!regex.test(input.value.trim())) isValid = false;
      }
      
      if (input.id === 'booking-guest-phone' && input.value.trim()) {
        const digits = input.value.replace(/\D/g, '').slice(-10);
        if (digits.length !== 10 || !/^[6-9]/.test(digits)) isValid = false;
      }

      if (isValid) {
        group.classList.remove('has-error');
      } else {
        group.classList.add('has-error');
      }
      
      validateFormState();
    }

    function validateFormState() {
      const name = (document.getElementById('booking-guest-name')?.value || '').trim();
      const email = (document.getElementById('booking-guest-email')?.value || '').trim();
      const phone = (document.getElementById('booking-guest-phone')?.value || '').trim();
      const terms = document.getElementById('booking-terms')?.checked;
      
      const checkin = document.getElementById('modal-checkin-field')?.value;
      const checkout = document.getElementById('modal-checkout-field')?.value;
      
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const cleanPhone = phone.replace(/\D/g, '').slice(-10);
      
      let isValid = true;
      
      if (!name) isValid = false;
      if (!email || !emailRegex.test(email)) isValid = false;
      if (!phone || cleanPhone.length !== 10 || !/^[6-9]/.test(cleanPhone)) isValid = false;
      if (!checkin || !checkout || new Date(checkout) <= new Date(checkin)) isValid = false;
      if (!terms) isValid = false;
      
      const btn = document.getElementById('btn-modal-confirm');
      if (btn) {
        btn.disabled = !isValid;
        
        // Update Button Text depending on Payment Method
        const selectedRadio = document.querySelector('input[name="paymentMethod"]:checked');
        const method = selectedRadio ? selectedRadio.value : 'Pay at Property';
        const total = stayDetails.total || 0;
        const advance = Math.round(total * 0.20);

        if (method === 'UPI / Net Banking') {
          btn.innerText = `🔒 Pay ₹${total.toLocaleString('en-IN')} via UPI & Confirm`;
        } else if (method === 'Pay Partial') {
          btn.innerText = `🔒 Pay 20% (₹${advance.toLocaleString('en-IN')}) & Confirm`;
        } else {
          btn.innerText = `✓ Confirm Booking (Pay at Property)`;
        }
      }
    }

    function triggerFormSubmit() {
      document.getElementById('booking-form').requestSubmit();
    }

    // Ajax Form Submission
    async function submitBookingForm(event) {
      event.preventDefault();
      
      const name = document.getElementById('booking-guest-name').value.trim();
      const email = document.getElementById('booking-guest-email').value.trim();
      const phone = document.getElementById('booking-guest-phone').value.trim();
      const requests = document.getElementById('booking-requests').value.trim();
      
      const checkin = document.getElementById('modal-checkin-field').value;
      const checkout = document.getElementById('modal-checkout-field').value;
      const guests = parseInt(document.getElementById('modal-guests-field').value);
      const roomType = document.getElementById('modal-room-type').value;
      
      const selectedRadio = document.querySelector('input[name="paymentMethod"]:checked');
      const paymentMethod = selectedRadio ? selectedRadio.value : 'Pay at Property';
      
      const utrEl = document.getElementById('upi-utr-input');
      const utrVal = utrEl ? utrEl.value.trim() : '';
      
      const btn = document.getElementById('btn-modal-confirm');
      btn.disabled = true;

      const isOnline = paymentMethod !== 'Pay at Property';
      if (isOnline) {
        btn.innerText = "🔒 Authorizing Secure Payment...";
        await new Promise(r => setTimeout(r, 600)); // Smooth payment UX feel
      } else {
        btn.innerText = "Processing...";
      }

      try {
        const bodyData = {
          listingId: '<%= listing._id || listing.id %>',
          listingName: '<%= listing.name %>',
          category: '<%= listing.category %>',
          location: '<%= listing.location %>',
          listingImage: '<%= listing.image %>',
          guestName: name,
          guestEmail: email,
          guestPhone: phone,
          checkIn: checkin,
          checkOut: checkout,
          nights: stayDetails.nights,
          guests: guests,
          roomType: roomType,
          pricePerNight: pricePerNight,
          subtotal: stayDetails.subtotal,
          tax: stayDetails.tax,
          totalAmount: stayDetails.total,
          paymentMethod: paymentMethod,
          utr: utrVal,
          specialRequests: requests
        };

        const response = await fetch('/booking/create', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(bodyData)
        });

        let result;
        try {
          result = await response.json();
        } catch (parseErr) {
          result = { success: false, error: "Unexpected response. Please log in and try again." };
        }
        
        if (response.ok && result.success) {
          renderSuccessScreen(result.booking);
        } else if (response.status === 401) {
          showToastNotification(result.error || "Please log in to complete your booking.");
          setTimeout(() => {
            window.location.href = result.redirect || `/user/login?redirect=${encodeURIComponent(window.location.pathname + '?resumeBooking=1')}`;
          }, 1200);
        } else {
          showToastNotification(result.error || "Booking failed. Try again.");
          btn.disabled = false;
          validateFormState();
        }
      } catch (err) {
        console.error(err);
        showToastNotification("Network error. Please try again.");
        btn.disabled = false;
        validateFormState();
      }
    }

    function renderSuccessScreen(booking) {
      const checkInStr = formatDateStr(booking.checkIn);
      const checkOutStr = formatDateStr(booking.checkOut);
      
      const contentArea = document.getElementById('modal-content-area');
      contentArea.innerHTML = `
        <div class="booking-success-screen">
          <div class="success-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <h2 class="success-title">Booking Confirmed!</h2>
          <p class="success-desc">Congratulations! Your stay at <strong>${escapeHtml(booking.listingName)}</strong> has been successfully booked.</p>

          <div class="success-details-card">
            <div class="success-detail-row">
              <span class="success-detail-label">Booking ID:</span>
              <strong class="success-detail-value" style="color:var(--primary); font-family:var(--font-mono); font-size:14px;">#${booking.bookingId}</strong>
            </div>
            ${booking.transactionId ? `
            <div class="success-detail-row">
              <span class="success-detail-label">Transaction ID:</span>
              <span class="success-detail-value" style="font-family:var(--font-mono); font-size:12px; color:#16a34a;">${booking.transactionId}</span>
            </div>` : ''}
            <div class="success-detail-row">
              <span class="success-detail-label">Listing:</span>
              <span class="success-detail-value">${escapeHtml(booking.listingName)} (${booking.category})</span>
            </div>
            <div class="success-detail-row">
              <span class="success-detail-label">Dates:</span>
              <span class="success-detail-value">📅 ${checkInStr} &rarr; ${checkOutStr} (${booking.nights} night${booking.nights > 1 ? 's' : ''})</span>
            </div>
            <div class="success-detail-row">
              <span class="success-detail-label">Guests & Room:</span>
              <span class="success-detail-value">👥 ${booking.guests} Guest${booking.guests > 1 ? 's' : ''} &bull; ${booking.roomType} Room</span>
            </div>
            <div class="success-detail-row">
              <span class="success-detail-label">Payment Method:</span>
              <span class="success-detail-value" style="color:#0284c7; font-weight:600;">${booking.paymentMethod}</span>
            </div>
            ${booking.advancePaid ? `
            <div class="success-detail-row">
              <span class="success-detail-label">Paid Online:</span>
              <span class="success-detail-value" style="color:#16a34a; font-weight:700;">₹${booking.advancePaid.toLocaleString('en-IN')}</span>
            </div>` : ''}
            ${booking.balanceDue ? `
            <div class="success-detail-row">
              <span class="success-detail-label">Due at Check-in:</span>
              <span class="success-detail-value" style="color:#e11d48; font-weight:700;">₹${booking.balanceDue.toLocaleString('en-IN')}</span>
            </div>` : ''}
            <div class="success-detail-row bold-total">
              <span class="success-detail-label">Total Booking Amount:</span>
              <span class="success-detail-value">₹${booking.totalAmount.toLocaleString('en-IN')}</span>
            </div>
          </div>
          
          <p style="font-size:12.5px; color:var(--text-soft); max-width: 400px; margin-bottom: var(--space-2);">A booking receipt with check-in instructions has been sent to your email address at <strong>${escapeHtml(booking.guestEmail)}</strong>.</p>

          <div class="success-actions">
            <a href="/my-bookings" class="btn btn-success-bookings">View My Bookings</a>
            <a href="/home/hotel" class="btn btn-success-home">Browse Listings</a>
          </div>
        </div>
      `;
    }

    function escapeHtml(str) {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Auto-resume booking after 1-time login
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('resumeBooking') === '1') {
        const saved = sessionStorage.getItem('pendingStayBooking');
        if (saved) {
          try {
            const data = JSON.parse(saved);
            if (data && data.listingId === '<%= listing._id || listing.id %>') {

              // Step 1: Populate all sidebar/card date fields first
              if (data.checkIn) document.getElementById('check-in-date').value = data.checkIn;
              if (data.checkOut) document.getElementById('check-out-date').value = data.checkOut;
              if (data.guests) document.getElementById('guest-count').value = data.guests;

              // Step 2: Recalculate prices (synchronously updates stayDetails)
              onDatesChanged();
              onGuestsChanged();

              // Step 3: Pre-fill all modal form fields BEFORE opening modal
              if (data.roomType) document.getElementById('modal-room-type').value = data.roomType;
              if (data.guestName) document.getElementById('booking-guest-name').value = data.guestName;
              if (data.guestEmail) document.getElementById('booking-guest-email').value = data.guestEmail;
              if (data.guestPhone) document.getElementById('booking-guest-phone').value = data.guestPhone;
              if (data.specialRequests) document.getElementById('booking-requests').value = data.specialRequests;
              if (data.utr) document.getElementById('upi-utr-input').value = data.utr;

              // Step 4: Restore payment method
              if (data.paymentMethod) {
                const radio = document.querySelector(`input[name="paymentMethod"][value="${data.paymentMethod}"]`);
                if (radio) {
                  const card = radio.closest('.payment-radio-card');
                  if (card) selectPaymentCard(card, data.paymentMethod);
                }
              }

              // Step 5: Accept terms
              const terms = document.getElementById('booking-terms');
              if (terms) terms.checked = true;

              // Step 6: Run validation so form state is correct
              validateFormState();

              // Step 7: Clear saved pending booking
              sessionStorage.removeItem('pendingStayBooking');
              sessionStorage.removeItem('loginRedirectSent');

              // Step 8: Open modal and auto-submit after a short visible delay
              setTimeout(() => {
                openBookingModal();
                showToastNotification("Welcome back! Completing your booking...");

                // Give modal a moment to render, then auto-submit
                setTimeout(() => {
                  const confirmBtn = document.getElementById('btn-modal-confirm');
                  if (confirmBtn && !confirmBtn.disabled) {
                    document.getElementById('booking-form').requestSubmit();
                  } else {
                    // If still disabled, just leave modal open for manual submit
                    showToastNotification("Please verify your details and click Confirm Booking.");
                  }
                }, 900);
              }, 400);
            }
          } catch (e) {
            console.error("Resume booking error:", e);
          }
        }
      }
    });
  </script>

</body>
</html>

        // Paid To
        const toBoxX = margin + 5 + halfBoxWidth + 4;
        doc.setFillColor(239, 246, 255);
        doc.roundedRect(toBoxX, y + 9, halfBoxWidth, 21, 2, 2, 'F');
        doc.setDrawColor(191, 219, 254);
        doc.roundedRect(toBoxX, y + 9, halfBoxWidth, 21, 2, 2, 'D');

        doc.setFontSize(7.5);
        doc.setTextColor(30, 64, 175);
        doc.text("PAID TO (BENEFICIARY CREDITED):", toBoxX + 3, y + 13.5);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(9.5);
        doc.setTextColor(30, 58, 138);
        doc.text("Gourab Das (Slice Bank)", toBoxX + 3, y + 18.5);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8);
        doc.setTextColor(30, 58, 138);
        doc.text("A/C: 033325222636602  |  IFSC: NESF0000333", toBoxX + 3, y + 23);
        doc.text("UPI ID: 9531820286@slc", toBoxX + 3, y + 27);

        // Stay & Guest Details Box
        y += 39;
        doc.setFillColor(255, 255, 255);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 48, 3, 3, 'F');
        doc.setDrawColor(226, 232, 240);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 48, 3, 3, 'D');

        doc.setFont("helvetica", "bold");
        doc.setFontSize(9);
        doc.setTextColor(71, 85, 105);
        doc.text("RESERVATION & GUEST DETAILS", margin + 5, y + 6);

        const checkInStr = booking.checkIn ? new Date(booking.checkIn).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '';
        const checkOutStr = booking.checkOut ? new Date(booking.checkOut).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '';

        const details = [
          ["Property:", `${booking.listingName || 'Stay'} (${booking.category || 'Hotel'})`],
          ["Primary Guest:", `${booking.guestName || ''}`],
          ["Contact Details:", `${booking.guestPhone || ''}  |  ${booking.guestEmail || ''}`],
          ["Stay Duration:", `${checkInStr}  to  ${checkOutStr} (${booking.nights || 1} night${(booking.nights || 1) > 1 ? 's' : ''})`],
          ["Guests & Room:", `${booking.guests || 1} Guest${(booking.guests || 1) > 1 ? 's' : ''}  |  ${booking.roomType || 'Standard'} Room`]
        ];

        let rowY = y + 13;
        details.forEach(([label, value]) => {
          doc.setFont("helvetica", "normal");
          doc.setFontSize(8.5);
          doc.setTextColor(100, 116, 139);
          doc.text(label, margin + 5, rowY);
          doc.setFont("helvetica", "bold");
          doc.setTextColor(15, 23, 42);
          doc.text(String(value), margin + 45, rowY);
          rowY += 7;
        });

        // Total Amount Box
        y += 53;
        doc.setFillColor(240, 253, 244);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 18, 3, 3, 'F');
        doc.setDrawColor(134, 239, 172);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 18, 3, 3, 'D');

        doc.setFont("helvetica", "bold");
        doc.setFontSize(9.5);
        doc.setTextColor(22, 101, 52);
        doc.text("TOTAL AMOUNT TRANSACTED & SETTLED", margin + 6, y + 7.5);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8);
        doc.setTextColor(21, 128, 61);
        doc.text("✓ Payment Verified & Received in Full", margin + 6, y + 13);

        doc.setFont("helvetica", "bold");
        doc.setFontSize(15);
        doc.setTextColor(21, 128, 61);
        const amountStr = `INR ${Number(booking.totalAmount || 0).toLocaleString('en-IN')}`;
        doc.text(amountStr, pageWidth - margin - 6, y + 11.5, { align: "right" });

        // Footer Notice
        y += 24;
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8);
        doc.setTextColor(148, 163, 184);
        doc.text("StayAndaman Booking Receipt - Valid proof of payment and stay reservation.", pageWidth / 2, y, { align: "center" });
        doc.text("Support Email: gourabsuper999@gmail.com  |  Phone: +91 9531820286", pageWidth / 2, y + 4.5, { align: "center" });

        // Save directly to file!
        const fileName = `StayAndaman-Receipt-${booking.bookingId || bookingId || 'Booking'}.pdf`;
        doc.save(fileName);

        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '✓ PDF Downloaded!';
          btn.style.background = '#059669';
          setTimeout(() => {
            btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:17px;height:17px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> <span>Download Receipt as PDF</span>`;
            btn.style.background = 'linear-gradient(135deg, #16a34a 0%, #15803d 100%)';
          }, 2500);
        }
      } catch (err) {
        console.error("jsPDF generation error:", err);
        window.print();
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = 'Download Receipt as PDF';
        }
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Auto-resume booking after 1-time login
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('resumeBooking') === '1') {
        const saved = sessionStorage.getItem('pendingStayBooking');
        if (saved) {
          try {
            const data = JSON.parse(saved);
            if (data && data.listingId === '<%= listing._id || listing.id %>') {

              // Step 1: Populate all sidebar/card date fields first
              if (data.checkIn) document.getElementById('check-in-date').value = data.checkIn;
              if (data.checkOut) document.getElementById('check-out-date').value = data.checkOut;
              if (data.guests) document.getElementById('guest-count').value = data.guests;

              // Step 2: Recalculate prices (synchronously updates stayDetails)
              onDatesChanged();
              onGuestsChanged();

              // Step 3: Pre-fill all modal form fields BEFORE opening modal
              if (data.roomType) document.getElementById('modal-room-type').value = data.roomType;
              if (data.guestName) document.getElementById('booking-guest-name').value = data.guestName;
              if (data.guestEmail) document.getElementById('booking-guest-email').value = data.guestEmail;
              if (data.guestPhone) document.getElementById('booking-guest-phone').value = data.guestPhone;
              if (data.specialRequests) document.getElementById('booking-requests').value = data.specialRequests;
              if (data.utr) document.getElementById('upi-utr-input').value = data.utr;

              // Step 4: Restore payment method
              if (data.paymentMethod) {
                const radio = document.querySelector(`input[name="paymentMethod"][value="${data.paymentMethod}"]`);
                if (radio) {
                  const card = radio.closest('.payment-radio-card');
                  if (card) selectPaymentCard(card, data.paymentMethod);
                }
              }

              // Step 5: Accept terms
              const terms = document.getElementById('booking-terms');
              if (terms) terms.checked = true;

              // Step 6: Run validation so form state is correct
              validateFormState();

              // Step 7: Clear saved pending booking
              sessionStorage.removeItem('pendingStayBooking');
              sessionStorage.removeItem('loginRedirectSent');

              // Step 8: Open modal and auto-submit after a short visible delay
              setTimeout(() => {
                openBookingModal();
                showToastNotification("Welcome back! Completing your booking...");

                // Give modal a moment to render, then auto-submit
                setTimeout(() => {
                  const confirmBtn = document.getElementById('btn-modal-confirm');
                  if (confirmBtn && !confirmBtn.disabled) {
                    document.getElementById('booking-form').requestSubmit();
                  } else {
                    // If still disabled, just leave modal open for manual submit
                    showToastNotification("Please verify your details and click Confirm Booking.");
                  }
                }, 900);
              }, 400);
            }
          } catch (e) {
            console.error("Resume booking error:", e);
          }
        }
      }
    });
  </script>


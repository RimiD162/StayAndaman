      const checkin = document.getElementById('modal-checkin-field').value;
      const checkout = document.getElementById('modal-checkout-field').value;
      const guests = parseInt(document.getElementById('modal-guests-field').value);
      const roomType = document.getElementById('modal-room-type').value;
      
      const selectedRadio = document.querySelector('input[name="paymentMethod"]:checked');
      const paymentMethod = selectedRadio ? selectedRadio.value : 'Pay at Property';
      
      const utrEl = document.getElementById('upi-utr-input');
      const utrVal = utrEl ? utrEl.value.trim() : '';
      
      const senderUpiEl = document.getElementById('upi-sender-input');
      const senderUpiVal = senderUpiEl ? senderUpiEl.value.trim() : '';

      const senderBankEl = document.getElementById('upi-app-select');
      const senderBankVal = senderBankEl ? senderBankEl.value : 'UPI App';
      
      const btn = document.getElementById('btn-modal-confirm');
      btn.disabled = true;

      const isOnline = paymentMethod !== 'Pay at Property';
      const contentArea = document.getElementById('modal-content-area');
      
      if (isOnline) {
        // Multi-stage interactive transaction verification overlay
        contentArea.innerHTML = `
          <div style="padding: 40px 20px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <div style="width: 54px; height: 54px; border: 4px solid #e2e8f0; border-top-color: #2563eb; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20px;"></div>
            <h3 id="verify-stage-title" style="font-size: 18px; font-weight: 800; color: #0f172a; margin-bottom: 8px;">
              Verifying Payment Transaction...
            </h3>
            <p id="verify-stage-desc" style="font-size: 13px; color: #64748b; margin-bottom: 16px; max-width: 360px;">
              Validating UTR reference <strong style="color: #0f172a; font-family: var(--font-mono);">${escapeHtml(utrVal)}</strong> with banking network...
            </p>
            <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 12px 18px; width: 100%; max-width: 380px; text-align: left; font-size: 12px;">

              </div>
              <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                <span style="color:#64748b;">From:</span>
                <span style="color:#0f172a;">${escapeHtml(senderUpiVal)} (${escapeHtml(senderBankVal)})</span>
              </div>
              <div style="display:flex; justify-content:space-between;">
                <span style="color:#64748b;">Beneficiary:</span>
                <span style="color:#2563eb; font-weight:600;">Gourab Das (Slice Bank)</span>
              </div>
            </div>
          </div>
        `;
        
        // Short realistic bank settlement simulation
        await new Promise(r => setTimeout(r, 700));
        const stageTitle = document.getElementById('verify-stage-title');
        const stageDesc = document.getElementById('verify-stage-desc');
        if (stageTitle) stageTitle.innerText = "Confirming Settlement with Beneficiary...";
        if (stageDesc) stageDesc.innerText = "Crediting amount to Gourab Das (A/C: 033325222636602)...";
        await new Promise(r => setTimeout(r, 600));
      } else {
        btn.innerText = "Processing Booking...";
      }

      try {
        const bodyData = {
          listingId: '<%= listing._id || listing.id %>',
          listingName: '<%= listing.name %>',
          category: '<%= listing.category %>',
          location: '<%= listing.location %>',
          listingImage: '<%= listing.image %>',
          guestName: name,
          guestEmail: email,
          guestPhone: phone,
          checkIn: checkin,
          checkOut: checkout,
          nights: stayDetails.nights,
          guests: guests,
          children: stayDetails.children || 0,
          roomType: roomType,
          pricePerNight: pricePerNight,
          childPricePerNight: childPricePerNight,
          subtotal: stayDetails.subtotal,
          tax: stayDetails.tax,
          totalAmount: stayDetails.total,
          paymentMethod: paymentMethod,
          senderUpi: senderUpiVal,
          senderBank: senderBankVal,
          utr: utrVal,
          specialRequests: requests
        };

        const response = await fetch('/booking/create', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(bodyData)
        });

        let result;
        try {
          result = await response.json();
        } catch (parseErr) {
          result = { success: false, error: "Unexpected response. Please log in and try again." };
        }
        
        if (response.ok && result.success) {
          renderSuccessScreen(result.booking);
        } else if (response.status === 401) {
          showToastNotification(result.error || "Please log in to complete your booking.");
          setTimeout(() => {
            window.location.href = result.redirect || `/user/login?redirect=${encodeURIComponent(window.location.pathname + '?resumeBooking=1')}`;
          }, 1200);
        } else {
          showToastNotification(result.error || "Booking failed. Try again.");
          btn.disabled = false;
          validateFormState();
        }
      } catch (err) {
        console.error(err);
        showToastNotification("Network error. Please try again.");
        btn.disabled = false;
        validateFormState();
      }
    }


    function copyText(str, btn) {
      if (!str) return;
      navigator.clipboard.writeText(str).then(() => {
        if (btn) {
          const orig = btn.innerText;
          btn.innerText = '✓ Copied!';
          const origBg = btn.style.background;
          btn.style.background = '#16a34a';
          btn.style.color = '#fff';
          setTimeout(() => {
            btn.innerText = orig;
            btn.style.background = origBg;
            btn.style.color = '';
          }, 2000);
        }
      }).catch(() => {
        alert('Copied: ' + str);
      });
    }

    function copyUpiId() {
      const idText = document.getElementById('upi-id-text')?.innerText || '9531820286@slc';
      copyText(idText, document.getElementById('btn-copy-upi'));
    }

    // Custom Radio buttons style selection triggers
    function selectPaymentCard(cardEl, method) {
      if (!cardEl) return;
      document.querySelectorAll('.payment-radio-card').forEach(c => c.classList.remove('active'));
      cardEl.classList.add('active');
      const radio = cardEl.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      const onlineBox = document.getElementById('online-payment-details-box');
      const upiContent = document.getElementById('upi-method-content');

      const isUpi = method === 'UPI / Net Banking' || (radio && radio.value === 'UPI / Net Banking');
      if (isUpi) {
        if (onlineBox) onlineBox.style.display = 'block';
        if (upiContent) upiContent.style.display = 'block';
        updatePaymentCalculations();
      } else {
        if (onlineBox) onlineBox.style.display = 'none';
      }

      validateFormState();
    }

    function updateRadioSelection(radioInput) {
      if (!radioInput) return;
      const card = radioInput.closest('.payment-radio-card');
      if (card) selectPaymentCard(card, radioInput.value);
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.payment-radio-card').forEach(card => {
        card.addEventListener('click', function(e) {
          const radio = this.querySelector('input[name="paymentMethod"]');
          if (radio) {
            selectPaymentCard(this, radio.value);
          }
        });
      });
    });


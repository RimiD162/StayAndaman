    // Form validations
    function validateField(input) {
      const group = input.closest('.booking-field-group');
      if (!group) return;
      
      let isValid = true;
      if (input.required && !input.value.trim()) {
        isValid = false;
      }
      
      if (input.type === 'email' && input.value.trim()) {
        const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!regex.test(input.value.trim())) isValid = false;
      }
      
      if (input.id === 'booking-guest-phone' && input.value.trim()) {
        const digits = input.value.replace(/\D/g, '').slice(-10);
        if (digits.length !== 10 || !/^[6-9]/.test(digits)) isValid = false;
      }

      if (isValid) {
        group.classList.remove('has-error');
      } else {
        group.classList.add('has-error');
      }
      
      validateFormState();
    }

    function validateFormState() {
      const name = (document.getElementById('booking-guest-name')?.value || '').trim();
      const email = (document.getElementById('booking-guest-email')?.value || '').trim();
      const phone = (document.getElementById('booking-guest-phone')?.value || '').trim();
      const terms = document.getElementById('booking-terms')?.checked;
      
      const checkin = document.getElementById('modal-checkin-field')?.value;
      const checkout = document.getElementById('modal-checkout-field')?.value;
      
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const cleanPhone = phone.replace(/\D/g, '').slice(-10);
      
      const selectedRadio = document.querySelector('input[name="paymentMethod"]:checked');
      const method = selectedRadio ? selectedRadio.value : 'Pay at Property';
      const isOnline = method === 'UPI / Net Banking';

      const senderUpiVal = (document.getElementById('upi-sender-input')?.value || '').trim();
      const utrVal = (document.getElementById('upi-utr-input')?.value || '').trim();

      let isValid = true;
      let onlineStepMissing = '';
      
      if (!name) isValid = false;
      if (!email || !emailRegex.test(email)) isValid = false;
      if (!phone || cleanPhone.length !== 10 || !/^[6-9]/.test(cleanPhone)) isValid = false;
      if (!checkin || !checkout || new Date(checkout) <= new Date(checkin)) isValid = false;
      if (!terms) isValid = false;
      
      if (isOnline) {
        if (!senderUpiVal) {
          isValid = false;
          onlineStepMissing = 'Enter Sender UPI ID / Mobile';
        } else if (!utrVal || utrVal.length < 4) {
          isValid = false;
          onlineStepMissing = 'Enter 12-Digit UTR No.';
        }
      }
      
      const btn = document.getElementById('btn-modal-confirm');
      if (btn) {
        btn.disabled = !isValid;
        
        const total = stayDetails.total || 0;

        if (isOnline) {
          if (!isValid && onlineStepMissing) {
            btn.innerText = `⚠️ ${onlineStepMissing}`;
          } else {
            btn.innerText = `🔒 Verify Payment & Confirm (₹${total.toLocaleString('en-IN')})`;
          }
        } else {
          btn.innerText = `✓ Confirm Booking (Pay at Property)`;
        }
      }
    }

    function triggerFormSubmit() {
      document.getElementById('booking-form').requestSubmit();
    }

    // Ajax Form Submission
    async function submitBookingForm(event) {
      event.preventDefault();
      
      const name = document.getElementById('booking-guest-name').value.trim();
      const email = document.getElementById('booking-guest-email').value.trim();
      const phone = document.getElementById('booking-guest-phone').value.trim();

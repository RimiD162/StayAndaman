              <div style="background: #fffbeb; border: 1.5px solid #fde68a; border-radius: 10px; padding: 12px 14px; margin-bottom: 12px; font-size: 12px; color: #92400e; line-height: 1.5;">
                <div style="font-weight: 800; margin-bottom: 3px; display: flex; align-items: center; gap: 5px;">
                  <span>🏨</span> PAYMENT DUE AT CHECK-IN
                </div>
                <div>
                  No online payment was processed. Please pay the total amount of <strong>₹${booking.totalAmount.toLocaleString('en-IN')}</strong> directly at the property desk during your check-in.
                </div>
              </div>

              <!-- Reservation IDs Bar -->
              <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; font-size: 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                <div>
                  <span style="color: #64748b; font-size: 10.5px; display: block;">Booking ID:</span>
                  <strong style="color: #0f172a; font-family: var(--font-mono); font-size: 13px;">#${booking.bookingId}</strong>
                </div>
                <div>
                  <span style="color: #64748b; font-size: 10.5px; display: block;">Payment Status:</span>
                  <strong style="color: #d97706; font-size: 12px;">Pending (Pay at Hotel)</strong>
                </div>
              </div>

              <!-- Stay Details -->
              <div style="font-size: 12px; display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px;">
                <div style="display: flex; justify-content: space-between;">
                  <span style="color: #64748b;">Property:</span>
                  <strong style="color: #0f172a; text-align: right;">${escapeHtml(booking.listingName)} (${booking.category})</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                  <span style="color: #64748b;">Primary Guest:</span>
                  <strong style="color: #0f172a;">${escapeHtml(booking.guestName)}</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                  <span style="color: #64748b;">Contact:</span>
                  <span style="color: #334155;">${escapeHtml(booking.guestPhone)} &bull; ${escapeHtml(booking.guestEmail)}</span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                  <span style="color: #64748b;">Stay Duration:</span>
                  <span style="color: #0f172a; font-weight: 600;">📅 ${checkInStr} &rarr; ${checkOutStr} (${booking.nights} night${booking.nights > 1 ? 's' : ''})</span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                  <span style="color: #64748b;">Guests & Room:</span>
                  <span style="color: #334155;">👥 ${booking.guests} Guest${booking.guests > 1 ? 's' : ''} (${booking.roomType})</span>
                </div>
              </div>

              <!-- Total Due Amount Box -->
              <div style="background: #f8fafc; border: 2px solid #cbd5e1; border-radius: 10px; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <span style="color: #475569; font-size: 11px; font-weight: 800; text-transform: uppercase; display: block;">
                    Total Amount Due at Check-In
                  </span>
                  <span style="color: #64748b; font-size: 10.5px;">Payable in Cash / Card / UPI at hotel</span>
                </div>
                <div style="font-size: 20px; font-weight: 800; color: #0f172a; font-family: var(--font-mono);">
                  ₹${booking.totalAmount.toLocaleString('en-IN')}
                </div>
              </div>

            </div>

            <!-- ACTIONS (NO PDF DOWNLOAD BUTTON FOR UNPAID / PAY-AT-PROPERTY) -->
            <div style="margin-top: 14px; width: 100%; max-width: 490px; display: flex; flex-direction: column; gap: 8px;">
              <div class="success-actions" style="display: flex; gap: 8px;">
                <a href="/my-bookings" class="btn btn-success-bookings" style="flex: 1; text-align: center; padding: 11px; font-size: 13.5px; font-weight: 700; background: #2563eb; color: #fff; border-radius: 8px; text-decoration: none;">View My Bookings</a>
                <a href="/home/hotel" class="btn btn-success-home" style="flex: 1; text-align: center; padding: 11px; font-size: 13.5px; font-weight: 700; background: #f1f5f9; color: #334155; border-radius: 8px; text-decoration: none;">Browse Listings</a>
              </div>
            </div>

          </div>
        `;
      }
    }

    function downloadReceiptAsPDF(bookingId) {
      const btn = document.getElementById('btn-download-pdf');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span style="display:inline-flex;align-items:center;gap:6px;">⏳ Generating PDF Receipt...</span>';
      }

      try {
        const booking = window.currentReceiptBooking || {};
        const JSPDFClass = (window.jspdf && window.jspdf.jsPDF) ? window.jspdf.jsPDF : window.jsPDF;

        if (!JSPDFClass) {
          // Direct fallback
          window.print();
          if (btn) { btn.disabled = false; btn.innerHTML = '<span>Download Receipt as PDF</span>'; }
          return;
        }

        const doc = new JSPDFClass({
          orientation: 'portrait',
          unit: 'mm',
          format: 'a4'
        });

        const pageWidth = doc.internal.pageSize.getWidth();
        const margin = 15;
        let y = 18;

        // Header
        doc.setTextColor(37, 99, 235);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(22);
        doc.text("StayAndaman", margin, y);

        // Status Badge
        doc.setFillColor(220, 252, 231);
        doc.roundedRect(pageWidth - margin - 52, y - 7, 52, 9, 3, 3, 'F');
        doc.setDrawColor(134, 239, 172);
        doc.roundedRect(pageWidth - margin - 52, y - 7, 52, 9, 3, 3, 'D');
        doc.setTextColor(21, 128, 61);
        doc.setFontSize(8.5);
        doc.setFont("helvetica", "bold");
        doc.text("PAID ONLINE & VERIFIED", pageWidth - margin - 26, y - 1, { align: "center" });

        y += 6;
        doc.setFont("helvetica", "bold");
        doc.setFontSize(10);
        doc.setTextColor(100, 116, 139);
        doc.text("OFFICIAL PAYMENT & TRANSACTION RECEIPT", margin, y);

        const dateStr = new Date().toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true });
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8);
        doc.text(dateStr, pageWidth - margin, y, { align: "right" });

        // Line
        y += 5;
        doc.setDrawColor(226, 232, 240);
        doc.setLineWidth(0.5);
        doc.line(margin, y, pageWidth - margin, y);

        // Booking Metadata Box
        y += 5;
        doc.setFillColor(248, 250, 252);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 22, 3, 3, 'F');
        doc.setDrawColor(226, 232, 240);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 22, 3, 3, 'D');

        doc.setFont("helvetica", "normal");
        doc.setFontSize(8.5);
        doc.setTextColor(100, 116, 139);
        doc.text("Booking ID:", margin + 5, y + 6);
        doc.text("Payment Mode:", margin + 95, y + 6);

        doc.setFont("helvetica", "bold");
        doc.setFontSize(11);
        doc.setTextColor(15, 23, 42);
        doc.text(`#${booking.bookingId || bookingId || 'SE-BOOKING'}`, margin + 5, y + 12);
        doc.setTextColor(37, 99, 235);
        doc.text(booking.paymentMethod || 'UPI / Net Banking', margin + 95, y + 12);

        if (booking.transactionId) {
          doc.setFont("helvetica", "normal");
          doc.setFontSize(8);
          doc.setTextColor(100, 116, 139);
          doc.text("Transaction Ref / UTR:", margin + 5, y + 18);
          doc.setFont("helvetica", "bold");
          doc.setTextColor(22, 163, 74);
          doc.text(String(booking.transactionId), margin + 38, y + 18);
        }

        // Account Transfer Box
        y += 27;
        doc.setFillColor(248, 250, 252);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 34, 3, 3, 'F');
        doc.setDrawColor(203, 213, 225);
        doc.roundedRect(margin, y, pageWidth - (margin * 2), 34, 3, 3, 'D');

        doc.setFont("helvetica", "bold");
        doc.setFontSize(9);
        doc.setTextColor(71, 85, 105);
        doc.text("TRANSACTION ACCOUNT FLOW", margin + 5, y + 6);

        // Paid From
        const halfBoxWidth = (pageWidth - (margin * 2) - 14) / 2;
        doc.setFillColor(255, 255, 255);
        doc.roundedRect(margin + 5, y + 9, halfBoxWidth, 21, 2, 2, 'F');
        doc.setDrawColor(226, 232, 240);
        doc.roundedRect(margin + 5, y + 9, halfBoxWidth, 21, 2, 2, 'D');

        doc.setFontSize(7.5);
        doc.setTextColor(100, 116, 139);
        doc.text("PAID FROM (SENDER ACCOUNT):", margin + 8, y + 13.5);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(9.5);
        doc.setTextColor(15, 23, 42);
        doc.text(String(booking.guestName || "Guest"), margin + 8, y + 18.5);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8);
        doc.setTextColor(71, 85, 105);
        const senderAccount = booking.senderUpi || (booking.guestPhone ? booking.guestPhone + '@upi' : 'Direct UPI');

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/images/logo-favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Book <%= listing.name %> on Stayandaman. Read reviews, explore amenities, and book your stay instantly.">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/listings.css">
  <link rel="stylesheet" href="/css/detail.css">
  <link rel="stylesheet" href="/css/booking.css">
  <title><%= listing.name %> — Stayandaman</title>
</head>
<body>

  <!-- ===== Navbar ===== -->
  <nav class="navbar" id="main-navbar">
    <a href="/home/hotel" class="navbar-logo">Stay<span>Andaman</span></a>

    <div class="navbar-links" id="navbar-links">
      <a href="/home/hotel" class="navbar-link <%= listing.category === 'Hotel' ? 'active' : '' %>">Hotels</a>
      <a href="/home/lodges" class="navbar-link <%= listing.category === 'Lodge' ? 'active' : '' %>">Lodges</a>
      <a href="/home/rentals" class="navbar-link <%= listing.category === 'Rental' ? 'active' : '' %>">Rentals</a>
    </div>

    <% if (user) { %>
    <div class="navbar-user" id="navbar-user" onclick="toggleDropdown()">
      <div class="navbar-avatar">
        <% if (user.avatar) { %>
          <img class="loaded" src="<%= user.avatar %>" alt="<%= user.fullName %>">
        <% } else { %>
          <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
        <% } %>
      </div>
      <span class="navbar-username"><%= user.fullName ? user.fullName.split(' ')[0] : 'User' %></span>
      <svg class="navbar-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>

      <div class="navbar-dropdown" id="navbar-dropdown">
        <a href="/profile" class="navbar-dropdown-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          My Profile
        </a>
        <a href="/my-bookings" class="navbar-dropdown-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          My Bookings
        </a>
        <div class="navbar-dropdown-divider"></div>
        <form action="/user/logout" method="POST" style="margin:0;">
          <button type="submit" class="navbar-dropdown-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Logout
          </button>
        </form>
      </div>
    </div>
    <% } else { %>
    <a href="/user/login" class="btn btn-gold btn-sm">Sign In</a>
    <% } %>

    <button class="navbar-toggle" id="navbar-toggle" onclick="document.getElementById('navbar-links').classList.toggle('show-mobile')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </nav>

  <!-- ===== Main Details Container ===== -->
  <div class="detail-container">
    
    <!-- Breadcrumbs -->
    <div class="listing-header-breadcrumb" style="justify-content: flex-start; margin-bottom: var(--space-4);">
      <a href="/home/<%= listing.category ? listing.category.toLowerCase() + 's' : 'hotel' %>" style="color: var(--text-soft);"><%= listing.category %>s</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;color: var(--text-soft);"><polyline points="9 18 15 12 9 6"/></svg>
      <span style="color: var(--text-dark); font-weight: 500;"><%= listing.name %></span>
    </div>

    <!-- Two Column Layout -->
    <div class="detail-layout">
      
      <!-- Left Column (60%) -->
      <div class="detail-left">
        
        <!-- Image Gallery Section -->
        <section class="gallery-section">
          <% if (galleryImages.length > 0) { %>
          <div class="main-image-container">
            <img id="main-gallery-img" class="loaded" src="<%= galleryImages[0] %>" alt="<%= listing.name %>">
          </div>
          <% if (galleryImages.length > 1) { %>
          <div class="thumbnails-row">
            <% galleryImages.forEach(function(imgUrl, idx) { %>
              <div class="thumbnail-card <%= idx === 0 ? 'active' : '' %>" onclick="swapGalleryImage('<%= imgUrl %>', this)">
                <img class="loaded" src="<%= imgUrl %>" alt="Thumbnail <%= idx + 1 %>">
              </div>
            <% }); %>
          </div>
          <% } %>
          <% } else { %>
          <div class="main-image-container" style="background:#f0f0f0;display:flex;align-items:center;justify-content:center;min-height:300px;">
            <p style="color:#999;font-size:16px;">No images available</p>
          </div>
          <% } %>
        </section>

        <!-- About this Property Section -->
        <section class="property-info-section">
          <h1 class="property-title"><%= listing.name %></h1>
          
          <div class="badges-row">
            <span class="detail-badge category"><%= listing.category %></span>
            <span class="detail-badge <%= listing.available !== false ? 'available' : 'full' %>">
              <%= listing.available !== false ? 'Available' : 'Full' %>
            </span>
          </div>

          <div class="detail-rating-row">
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="star-fill"><%= i <= (listing.rating || 0) ? '★' : '☆' %></span>
            <% } %>
            <strong style="color: var(--text-dark); margin-left: 6px;"><%= listing.rating || 0 %>.0</strong>
          </div>

          <div class="detail-location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><%= listing.location || 'Location not specified' %></span>
          </div>

          <hr class="divider">

          <h2 class="section-subtitle-detail">About This Property</h2>
          <p class="description-text">
            <%= listing.description || 'Welcome to ' + listing.name + '. Experience premium travel hospitality with carefully curated options, modern facilities, and a central location near tourist spots and public transit. We promise a safe, neat, and highly satisfying service standard.' %>
          </p>
        </section>

        <hr class="divider">

        <!-- Amenities Section -->
        <section class="amenities-section">
          <h2 class="section-subtitle-detail">What's Included</h2>
          <div class="amenities-detail-grid">
            <% 
            const allPossibleAmenities = [
              { name: "WiFi", label: "📶 WiFi" },
              { name: "AC", label: "❄️ AC" },
              { name: "Pool", label: "🏊 Pool" },
              { name: "Parking", label: "🅿️ Parking" },
              { name: "Breakfast", label: "🍳 Breakfast" }
            ];
            %>
            <% allPossibleAmenities.forEach(function(item) { %>
              <% const isIncluded = listing.amenities && listing.amenities.some(a => a.toLowerCase() === item.name.toLowerCase()); %>
              <div class="amenity-pill <%= isIncluded ? 'available' : 'muted' %>">
                <span class="amenity-pill-icon">
                  <%= item.label.split(' ')[0] %>
                </span>
                <span>
                  <%= item.label.substring(item.label.indexOf(' ') + 1) %>
                </span>
              </div>
            <% }); %>
          </div>
        </section>

        <hr class="divider">

        <!-- Location Box -->
        <section class="location-section">
          <h2 class="section-subtitle-detail">Location</h2>
          <div class="address-box">
            <strong>📍 Full Address:</strong> <%= listing.location || 'Stayandaman Property Address, Shimla, India' %>
          </div>
        </section>



      </div>

      <!-- Right Column (40%) -->
      <div class="detail-right">
        
        <!-- Sticky Sidebar Wrapper -->
        <div class="detail-sidebar-sticky">
          
          <!-- Sticky Booking Card -->
          <div class="booking-sticky-card">
            <div class="booking-card-price-row">
              <div class="booking-card-price">
                ₹<span id="price-per-night"><%= listing.price %></span>
                <span>/ night</span>
              </div>
            </div>

            <div class="booking-card-meta">
              <span>⭐ <%= listing.rating || 0 %>.0</span>
              <span>📍 <%= listing.location.split(',')[0] %></span>
            </div>

            <!-- Date Inputs -->
            <div class="date-pickers-container">
              <div class="date-picker-box">
                <div class="date-picker-label">Check In</div>
                <input type="date" id="check-in-date" class="date-picker-input" onchange="onDatesChanged()">
              </div>
              <div class="date-picker-box">
                <div class="date-picker-label">Check Out</div>
                <input type="date" id="check-out-date" class="date-picker-input" onchange="onDatesChanged()">
              </div>
            </div>

            <!-- Guest Count Select -->
            <div class="guest-picker-container">
              <div class="date-picker-label">Guests</div>
              <select id="guest-count" class="guest-picker-select" onchange="onGuestsChanged()">
                <% for (let i = 1; i <= 10; i++) { %>
                  <option value="<%= i %>"><%= i %> Adult<%= i > 1 ? 's' : '' %></option>
                <% } %>
              </select>
            </div>

            <!-- Price Breakdown Container -->
            <div id="breakdown-area" style="display: none;">
              <div class="price-breakdown">
                <div class="breakdown-row">
                  <span id="subtotal-calc-label">1 night = ₹3,455</span>
                  <span id="subtotal-calc-val">₹3,455</span>
                </div>
                <div class="breakdown-row total">
                  <span>Total</span>
                  <span id="total-amount-val">₹4,077</span>
                </div>
              </div>
            </div>
            
            <div id="select-dates-hint" style="color: var(--text-soft); font-size: 13px; text-align: center; margin-bottom: var(--space-4); font-weight: 500;">
              Please select valid check-in and check-out dates to calculate total pricing.
            </div>

            <!-- Action Button -->
            <button id="btn-open-booking" class="btn-book-now" onclick="openBookingModal()">
              Book Now
            </button>

            <!-- Security Badges -->
            <div class="booking-card-benefits">
              <div class="benefit-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="20 6 9 17 4 12"/></svg>
                <span>✓ Free cancellation up to 24 hours prior</span>
              </div>
              <div class="benefit-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="20 6 9 17 4 12"/></svg>
                <span>✓ No booking fees or hidden costs</span>
              </div>
              <div class="benefit-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="20 6 9 17 4 12"/></svg>
                <span>✓ Instant booking confirmation</span>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- Similar Listings Section -->
    <% if (typeof similarListings !== 'undefined' && similarListings && similarListings.length > 0) { %>
    <section class="similar-properties">
      <h2 class="section-title-text" style="font-family:var(--font-display); font-size:24px; font-weight:700; margin-bottom:var(--space-4); color:var(--primary);">
        Similar Properties You May Like
      </h2>
      <div class="listings-grid" style="grid-template-columns: repeat(3, 1fr); gap: var(--space-6);">
        <% similarListings.forEach(function(sim, idx) { %>
          <div class="grid-card listing-card" data-name="<%= (sim.name || '').toLowerCase() %>" data-rating="<%= sim.rating || 0 %>">
            <div class="card-img-wrapper grid-card-img-wrap">
              <img class="grid-card-img loaded" src="<%= sim.image || getFallbackImage(sim.category, idx) %>" alt="<%= sim.name %>" loading="lazy" onerror="this.src='<%= getFallbackImage(sim.category, idx) %>'">
              <span class="grid-card-badge <%= sim.category.toLowerCase() %>"><%= sim.category %></span>
              <span class="grid-card-avail <%= sim.available !== false ? 'available' : 'unavailable' %>"><%= sim.available !== false ? 'Available' : 'Full' %></span>
            </div>
            <div class="grid-card-body">
              <h3 class="grid-card-name"><%= sim.name %></h3>
              <div class="grid-card-location">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= sim.location || 'Location not specified' %>
              </div>
              <div class="grid-card-rating">
                <% for (let i = 1; i <= 5; i++) { %>
                  <svg class="star <%= i <= (sim.rating || 0) ? '' : 'empty' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <% } %>
                <span><%= sim.rating || 0 %>/5</span>
              </div>
              <% if (sim.amenities && sim.amenities.length > 0) { %>
                <div class="grid-card-amenities">
                  <% sim.amenities.slice(0, 4).forEach(function(a) { %>
                    <span class="amenity-tag"><%= a %></span>
                  <% }); %>
                </div>
              <% } %>
              <div class="grid-card-footer">
                <div class="grid-card-price">₹<%= sim.price ? sim.price.toLocaleString('en-IN') : '—' %> <span>/ night</span></div>
                <div class="grid-card-buttons">
                  <a href="/listing/<%= sim._id || sim.id %>" class="btn-view-details">View Details &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
    <% } %>

  </div>

  <!-- ===== Booking Modal overlay ===== -->
  <div class="booking-modal-overlay" id="booking-modal">
    <div class="booking-modal-container">
      
      <!-- Close button -->
      <button class="booking-modal-close" onclick="closeBookingModal()">✕</button>

      <!-- Modal Content Wrapper (Forms / Success Screen) -->
      <div id="modal-content-area">
        
        <!-- Modal Header -->
        <div class="booking-modal-header">
          <h2 class="booking-modal-title">🏨 Confirm Your Booking</h2>
          <div class="booking-modal-subtitle" id="modal-subtitle-prop"><%= listing.name %> &bull; <%= listing.location %></div>
        </div>

        <!-- Booking Summary bar inside modal -->
        <div class="booking-summary-bar">
          <div class="summary-dates-col">
            <span class="summary-dates-lbl">Stay Duration</span>
            <span class="summary-dates-val">
              <span id="modal-summary-checkin">—</span> 
              &rarr; 
              <span id="modal-summary-checkout">—</span>
            </span>
          </div>
          <div class="summary-details-col">
            <div>
              <div class="summary-item-title">Nights</div>
              <div class="summary-item-val" id="modal-summary-nights">—</div>
            </div>
            <div>
              <div class="summary-item-title">Guests</div>
              <div class="summary-item-val" id="modal-summary-guests">—</div>
            </div>
            <div>
              <div class="summary-item-title">Total</div>
              <div class="summary-item-val" style="color: var(--secondary);" id="modal-summary-total">—</div>
            </div>
          </div>
        </div>

        <!-- Form fields -->
        <div class="booking-modal-body">
          <form id="booking-form" onsubmit="submitBookingForm(event)">
            
            <!-- User Information Section -->
            <div class="booking-form-section">
              <h3 class="booking-form-section-title">Personal Information</h3>
              <div class="booking-form-grid full-width-inputs">
                
                <!-- Full Name -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="booking-guest-name">Full Name *</label>
                  <input type="text" id="booking-guest-name" class="booking-input-field" required 
                    placeholder="Enter your full name" value="<%= user ? user.fullName : '' %>" oninput="validateField(this)">
                  <span class="error-message">Full name is required.</span>
                </div>

                <!-- Email -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="booking-guest-email">Email Address *</label>
                  <input type="email" id="booking-guest-email" class="booking-input-field" required 
                    placeholder="Enter your email address" value="<%= user ? user.email : '' %>" oninput="validateField(this)">
                  <span class="error-message">Enter a valid email address.</span>
                </div>

                <!-- Phone -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="booking-guest-phone">Phone Number *</label>
                  <input type="tel" id="booking-guest-phone" class="booking-input-field" required 
                    placeholder="Enter 10-digit Indian number" value="<%= user ? (user.phone || '') : '' %>" oninput="validateField(this)">
                  <span class="error-message">Enter a valid 10-digit mobile number starting with 6-9.</span>
                </div>

                <!-- Special Requests -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="booking-requests">Special Requests (Optional)</label>
                  <textarea id="booking-requests" class="booking-input-field" style="height: 70px; resize: none;" 
                    placeholder="Any special requirements? (e.g. early check-in, ground floor room, anniversary celebration...)"></textarea>
                </div>

              </div>
            </div>

            <!-- Stay Details Section -->
            <div class="booking-form-section">
              <h3 class="booking-form-section-title">Stay Details</h3>
              <div class="booking-form-grid">
                
                <!-- Check In -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="modal-checkin-field">Check In Date *</label>
                  <input type="date" id="modal-checkin-field" class="booking-input-field" required onchange="syncDatesFromModal()">
                  <span class="error-message">Check-in date is required.</span>
                </div>

                <!-- Check Out -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="modal-checkout-field">Check Out Date *</label>
                  <input type="date" id="modal-checkout-field" class="booking-input-field" required onchange="syncDatesFromModal()">
                  <span class="error-message">Check-out must be after check-in.</span>
                </div>

                <!-- Guest count -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="modal-guests-field">Number of Guests *</label>
                  <select id="modal-guests-field" class="booking-input-field" required onchange="syncGuestsFromModal()">
                    <% for (let i = 1; i <= 10; i++) { %>
                      <option value="<%= i %>"><%= i %> Guest<%= i > 1 ? 's' : '' %></option>
                    <% } %>
                  </select>
                </div>

                <!-- Room Type -->
                <div class="booking-field-group">
                  <label class="booking-input-label" for="modal-room-type">Room Type *</label>
                  <select id="modal-room-type" class="booking-input-field" required>
                    <option value="Standard">Standard Room</option>
                    <option value="Deluxe" selected>Deluxe Room</option>
                    <option value="Suite">Premium Suite</option>
                  </select>
                </div>

              </div>
            </div>

            <!-- Payment Method Section -->
            <div class="booking-form-section">
              <h3 class="booking-form-section-title">Payment Method</h3>
              <div class="payment-methods-grid">
                
                <!-- Option 1: Pay at property -->
                <label class="payment-radio-card active" onclick="selectPaymentCard(this, 'Pay at Property')">
                  <div class="payment-radio-left">
                    <input type="radio" name="paymentMethod" value="Pay at Property" checked style="display:none;" onchange="updateRadioSelection(this)">
                    <div class="payment-radio-circle"></div>
                    <div class="payment-radio-text-wrap">
                      <span class="payment-radio-title">Pay at Property</span>
                      <span class="payment-radio-desc">No payment needed today. Pay full amount during check-in.</span>
                    </div>
                  </div>
                  <span class="payment-icon">🏢</span>
                </label>

                <!-- Option 2: UPI / Net Banking -->
                <label class="payment-radio-card" onclick="selectPaymentCard(this, 'UPI / Net Banking')">
                  <div class="payment-radio-left">
                    <input type="radio" name="paymentMethod" value="UPI / Net Banking" style="display:none;" onchange="updateRadioSelection(this)">
                    <div class="payment-radio-circle"></div>
                    <div class="payment-radio-text-wrap">
                      <span class="payment-radio-title">UPI / Net Banking (Instant Pay)</span>
                      <span class="payment-radio-desc">Fast payment authorization via PhonePe, GPay, Paytm, etc.</span>
                    </div>
                  </div>
                  <span class="payment-icon">⚡</span>
                </label>

                <!-- Option 3: Pay partial -->
                <label class="payment-radio-card" onclick="selectPaymentCard(this, 'Pay Partial')">
                  <div class="payment-radio-left">
                    <input type="radio" name="paymentMethod" value="Pay Partial" style="display:none;" onchange="updateRadioSelection(this)">
                    <div class="payment-radio-circle"></div>
                    <div class="payment-radio-text-wrap">
                      <span class="payment-radio-title">Pay Partial (20% Advance Online)</span>
                      <span class="payment-radio-desc" id="partial-desc-text">Pay 20% now to reserve & rest at check-in.</span>
                    </div>
                  </div>
                  <span class="payment-icon">💰</span>
                </label>

              </div>

              <!-- Interactive Online Payment Box -->
              <div id="online-payment-details-box" style="margin-top: 14px; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 14px; display: none;">
                
                <!-- Partial Advance Breakdown Alert if selected -->
                <div id="partial-method-content" style="display:none; margin-bottom: 12px; padding: 10px 12px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;">
                  <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                    <span style="color: #166534; font-weight: 500;">Pay Now (20% Advance):</span>
                    <strong id="partial-advance-val" style="color: #15803d; font-family: var(--font-mono); font-size: 14px;">₹0</strong>
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 4px;">
                    <span style="color: #64748b;">Due at Check-in (80% Balance):</span>
                    <strong id="partial-balance-val" style="color: #334155; font-family: var(--font-mono);">₹0</strong>
                  </div>
                  <div style="font-size: 11px; color: #0284c7; margin-top: 4px;">
                    💡 Advance is 100% refundable if cancelled up to 24 hours before check-in.
                  </div>
                </div>

                <!-- UPI Payment Card with Real QR -->
                <div id="upi-method-content">
                  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <span style="font-size: 13px; font-weight: 700; color: #1e293b;">⚡ UPI Instant Payment</span>
                    <span id="upi-pay-amount-badge" style="font-size: 13.5px; font-weight: 700; color: #15803d; font-family: var(--font-mono); background: #dcfce7; border: 1px solid #86efac; padding: 3px 10px; border-radius: 6px;">₹0</span>
                  </div>

                  <!-- QR Code Card Box -->
                  <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 12px; padding: 14px; text-align: center; box-shadow: 0 2px 6px rgba(0,0,0,0.04); margin-bottom: 12px;">
                    <div style="font-size: 12px; color: #475569; margin-bottom: 8px; font-weight: 600;">
